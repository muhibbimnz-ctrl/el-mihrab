{"n":104,"a":[{"n":1,"g":6180,"j":30,"p":601,"sj":false,"t":"Woe unto every backbiter, slanderer,"},{"n":2,"g":6181,"j":30,"p":601,"sj":false,"t":"who has gathered riches and counted them over"},{"n":3,"g":6182,"j":30,"p":601,"sj":false,"t":"thinking his riches have made him immortal!"},{"n":4,"g":6183,"j":30,"p":601,"sj":false,"t":"No indeed; he shall be thrust into the Crusher;"},{"n":5,"g":6184,"j":30,"p":601,"sj":false,"t":"and what shall teach thee what is the Crusher;"},{"n":6,"g":6185,"j":30,"p":601,"sj":false,"t":"The Fire of God kindled"},{"n":7,"g":6186,"j":30,"p":601,"sj":false,"t":"roaring over the hearts"},{"n":8,"g":6187,"j":30,"p":601,"sj":false,"t":"covered down upon them,"},{"n":9,"g":6188,"j":30,"p":601,"sj":false,"t":"in columns outstretched."}]}
