{"n":112,"a":[{"n":1,"g":6222,"j":30,"p":604,"sj":false,"t":"Say: 'He is God, One,"},{"n":2,"g":6223,"j":30,"p":604,"sj":false,"t":"God, the Everlasting Refuge,"},{"n":3,"g":6224,"j":30,"p":604,"sj":false,"t":"who has not begotten, and has not been begotten,"},{"n":4,"g":6225,"j":30,"p":604,"sj":false,"t":"and equal to Him is not any one.'"}]}
