{"n":88,"a":[{"n":1,"g":5968,"j":30,"p":592,"sj":false,"t":"Hast thou received the story of the Enveloper?"},{"n":2,"g":5969,"j":30,"p":592,"sj":false,"t":"Faces on that day humbled,"},{"n":3,"g":5970,"j":30,"p":592,"sj":false,"t":"labouring, toilworn,"},{"n":4,"g":5971,"j":30,"p":592,"sj":false,"t":"roasting at a scorching fire,"},{"n":5,"g":5972,"j":30,"p":592,"sj":false,"t":"watered at a boiling fountain,"},{"n":6,"g":5973,"j":30,"p":592,"sj":false,"t":"no food for them but cactus thorn"},{"n":7,"g":5974,"j":30,"p":592,"sj":false,"t":"unfattening, unappeasing hunger."},{"n":8,"g":5975,"j":30,"p":592,"sj":false,"t":"Faces on that day jocund,"},{"n":9,"g":5976,"j":30,"p":592,"sj":false,"t":"with their striving well-pleased,"},{"n":10,"g":5977,"j":30,"p":592,"sj":false,"t":"in a sublime Garden,"},{"n":11,"g":5978,"j":30,"p":592,"sj":false,"t":"hearing there no babble;"},{"n":12,"g":5979,"j":30,"p":592,"sj":false,"t":"therein a running fountain,"},{"n":13,"g":5980,"j":30,"p":592,"sj":false,"t":"therein uplifted couches"},{"n":14,"g":5981,"j":30,"p":592,"sj":false,"t":"and goblets set forth"},{"n":15,"g":5982,"j":30,"p":592,"sj":false,"t":"and cushions arrayed"},{"n":16,"g":5983,"j":30,"p":592,"sj":false,"t":"and carpets outspread."},{"n":17,"g":5984,"j":30,"p":592,"sj":false,"t":"What, do they not consider how the camel was created,"},{"n":18,"g":5985,"j":30,"p":592,"sj":false,"t":"how heaven was lifted up,"},{"n":19,"g":5986,"j":30,"p":592,"sj":false,"t":"how the mountains were hoisted,"},{"n":20,"g":5987,"j":30,"p":592,"sj":false,"t":"how the earth was outstretched?"},{"n":21,"g":5988,"j":30,"p":592,"sj":false,"t":"Then remind them! Thou art only a reminder;"},{"n":22,"g":5989,"j":30,"p":592,"sj":false,"t":"thou art not charged to oversee them."},{"n":23,"g":5990,"j":30,"p":592,"sj":false,"t":"But he who turns his back, and disbelieves,"},{"n":24,"g":5991,"j":30,"p":592,"sj":false,"t":"God shall chastise him with the greatest chastisement."},{"n":25,"g":5992,"j":30,"p":592,"sj":false,"t":"Truly, to Us is their return;"},{"n":26,"g":5993,"j":30,"p":592,"sj":false,"t":"then upon Us shall rest their reckoning."}]}
