{"n":102,"a":[{"n":1,"g":6169,"j":30,"p":600,"sj":false,"t":"Abundance distracts you."},{"n":2,"g":6170,"j":30,"p":600,"sj":false,"t":"Until you visit the graveyards."},{"n":3,"g":6171,"j":30,"p":600,"sj":false,"t":"Indeed, you will know."},{"n":4,"g":6172,"j":30,"p":600,"sj":false,"t":"Certainly, you will know."},{"n":5,"g":6173,"j":30,"p":600,"sj":false,"t":"If you knew with knowledge of certainty."},{"n":6,"g":6174,"j":30,"p":600,"sj":false,"t":"You would see the Inferno."},{"n":7,"g":6175,"j":30,"p":600,"sj":false,"t":"Then you will see it with the eye of certainty."},{"n":8,"g":6176,"j":30,"p":600,"sj":false,"t":"Then, on that Day, you will be questioned about the Bliss."}]}
