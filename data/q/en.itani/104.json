{"n":104,"a":[{"n":1,"g":6180,"j":30,"p":601,"sj":false,"t":"Woe to every slanderer backbiter."},{"n":2,"g":6181,"j":30,"p":601,"sj":false,"t":"Who gathers wealth and counts it over."},{"n":3,"g":6182,"j":30,"p":601,"sj":false,"t":"Thinking that his wealth has made him immortal."},{"n":4,"g":6183,"j":30,"p":601,"sj":false,"t":"By no means. He will be thrown into the Crusher."},{"n":5,"g":6184,"j":30,"p":601,"sj":false,"t":"And what will make you realize what the Crusher is?"},{"n":6,"g":6185,"j":30,"p":601,"sj":false,"t":"God's kindled Fire."},{"n":7,"g":6186,"j":30,"p":601,"sj":false,"t":"That laps to the hearts."},{"n":8,"g":6187,"j":30,"p":601,"sj":false,"t":"It closes in on them."},{"n":9,"g":6188,"j":30,"p":601,"sj":false,"t":"In extended columns."}]}
