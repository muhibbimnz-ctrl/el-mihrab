{"n":112,"a":[{"n":1,"g":6222,"j":30,"p":604,"sj":false,"t":"Say, “He is God, the One."},{"n":2,"g":6223,"j":30,"p":604,"sj":false,"t":"God, the Absolute."},{"n":3,"g":6224,"j":30,"p":604,"sj":false,"t":"He begets not, nor was He begotten."},{"n":4,"g":6225,"j":30,"p":604,"sj":false,"t":"And there is nothing comparable to Him.”"}]}
