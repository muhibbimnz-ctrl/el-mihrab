{"n":94,"a":[{"n":1,"g":6091,"j":30,"p":596,"sj":false,"t":"Did We not soothe your heart?"},{"n":2,"g":6092,"j":30,"p":596,"sj":false,"t":"And lift from you your burden."},{"n":3,"g":6093,"j":30,"p":596,"sj":false,"t":"Which weighed down your back?"},{"n":4,"g":6094,"j":30,"p":596,"sj":false,"t":"And raised for you your reputation?"},{"n":5,"g":6095,"j":30,"p":596,"sj":false,"t":"With hardship comes ease."},{"n":6,"g":6096,"j":30,"p":596,"sj":false,"t":"With hardship comes ease."},{"n":7,"g":6097,"j":30,"p":596,"sj":false,"t":"When your work is done, turn to devotion."},{"n":8,"g":6098,"j":30,"p":596,"sj":false,"t":"And to your Lord turn for everything."}]}
