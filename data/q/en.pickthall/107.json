{"n":107,"a":[{"n":1,"g":6198,"j":30,"p":602,"sj":false,"t":"Hast thou observed him who belieth religion?"},{"n":2,"g":6199,"j":30,"p":602,"sj":false,"t":"That is he who repelleth the orphan,"},{"n":3,"g":6200,"j":30,"p":602,"sj":false,"t":"And urgeth not the feeding of the needy."},{"n":4,"g":6201,"j":30,"p":602,"sj":false,"t":"Ah, woe unto worshippers"},{"n":5,"g":6202,"j":30,"p":602,"sj":false,"t":"Who are heedless of their prayer;"},{"n":6,"g":6203,"j":30,"p":602,"sj":false,"t":"Who would be seen (at worship)"},{"n":7,"g":6204,"j":30,"p":602,"sj":false,"t":"Yet refuse small kindnesses!"}]}
