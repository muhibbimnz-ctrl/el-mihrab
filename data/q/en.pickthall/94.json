{"n":94,"a":[{"n":1,"g":6091,"j":30,"p":596,"sj":false,"t":"Have We not caused thy bosom to dilate,"},{"n":2,"g":6092,"j":30,"p":596,"sj":false,"t":"And eased thee of the burden"},{"n":3,"g":6093,"j":30,"p":596,"sj":false,"t":"Which weighed down thy back;"},{"n":4,"g":6094,"j":30,"p":596,"sj":false,"t":"And exalted thy fame?"},{"n":5,"g":6095,"j":30,"p":596,"sj":false,"t":"But lo! with hardship goeth ease,"},{"n":6,"g":6096,"j":30,"p":596,"sj":false,"t":"Lo! with hardship goeth ease;"},{"n":7,"g":6097,"j":30,"p":596,"sj":false,"t":"So when thou art relieved, still toil"},{"n":8,"g":6098,"j":30,"p":596,"sj":false,"t":"And strive to please thy Lord."}]}
