{"n":1,"a":[{"n":1,"g":1,"j":1,"p":1,"sj":false,"t":"Rahman ve Rahim Allah'ın adıyla"},{"n":2,"g":2,"j":1,"p":1,"sj":false,"t":"Alemlerin Rabbi (sahibi, yetiştiricisi) Allah'a hamdolsun."},{"n":3,"g":3,"j":1,"p":1,"sj":false,"t":"(O) Rahman'dır, Rahim'dir."},{"n":4,"g":4,"j":1,"p":1,"sj":false,"t":"Din (ceza ve mükafat) gününün sahibidir."},{"n":5,"g":5,"j":1,"p":1,"sj":false,"t":"(Ya Rabbi) Ancak sana kulluk eder, ancak Senden yardım isteriz!"},{"n":6,"g":6,"j":1,"p":1,"sj":false,"t":"Bizi doğru yola ilet:"},{"n":7,"g":7,"j":1,"p":1,"sj":false,"t":"-ni'met verdiğin kimselerin yoluna. Kendilerine gazabedilmiş olanların ve sapmışların yoluna değil. (ya Rabbi)!"}]}
