{"n":100,"a":[{"n":1,"g":6147,"j":30,"p":599,"sj":false,"t":"Andolsun nefesleriyle (güp güp) ses çıkararak koşan(at)lara,"},{"n":2,"g":6148,"j":30,"p":599,"sj":false,"t":"(Tırnaklariyle yerden) Ateş çıkaranlara,"},{"n":3,"g":6149,"j":30,"p":599,"sj":false,"t":"Sabahleyin akın edenlere,"},{"n":4,"g":6150,"j":30,"p":599,"sj":false,"t":"(Koşarak) Toz koparanlara,"},{"n":5,"g":6151,"j":30,"p":599,"sj":false,"t":"Derken bir topluluğun ortasına dalanlara."},{"n":6,"g":6152,"j":30,"p":599,"sj":false,"t":"(Bunlara andolsun) Ki insan, Rabbine karşı çok nankördür."},{"n":7,"g":6153,"j":30,"p":599,"sj":false,"t":"Ve o da buna şahiddir."},{"n":8,"g":6154,"j":30,"p":599,"sj":false,"t":"Doğrusu o, malı çok sever."},{"n":9,"g":6155,"j":30,"p":599,"sj":false,"t":"Bilmez mi o, kabirlerde olanlar dışarı atıldığı,"},{"n":10,"g":6156,"j":30,"p":600,"sj":false,"t":"Göğüslerde bulunanlar devşirildiği zaman,"},{"n":11,"g":6157,"j":30,"p":600,"sj":false,"t":"O gün Rabbleri onların her halini haber almış(gizli ve açık bütün yaptıklarını bilmiş)tir."}]}
