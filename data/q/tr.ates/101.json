{"n":101,"a":[{"n":1,"g":6158,"j":30,"p":600,"sj":false,"t":"Çarpan olay!"},{"n":2,"g":6159,"j":30,"p":600,"sj":false,"t":"Nedir o çarpan olay?"},{"n":3,"g":6160,"j":30,"p":600,"sj":false,"t":"O çarpan olayın ne olduğunu sen nereden bileceksin?"},{"n":4,"g":6161,"j":30,"p":600,"sj":false,"t":"O gün insanlar, yayılmış pervaneler gibi olur(lar)."},{"n":5,"g":6162,"j":30,"p":600,"sj":false,"t":"Dağlar atılmış renkli yün gibi olur."},{"n":6,"g":6163,"j":30,"p":600,"sj":false,"t":"Kimin tartıları ağır gelirse,"},{"n":7,"g":6164,"j":30,"p":600,"sj":false,"t":"O, memmun edici bir hayat içindedir."},{"n":8,"g":6165,"j":30,"p":600,"sj":false,"t":"Kimin tartıları hafif gelirse,"},{"n":9,"g":6166,"j":30,"p":600,"sj":false,"t":"Onun anası (bağrına atılacağı) haviye(uçurum)dur."},{"n":10,"g":6167,"j":30,"p":600,"sj":false,"t":"Onun ne olduğunu sen nereden bileceksin?"},{"n":11,"g":6168,"j":30,"p":600,"sj":false,"t":"Kızgın bir ateştir!"}]}
