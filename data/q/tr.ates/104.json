{"n":104,"a":[{"n":1,"g":6180,"j":30,"p":601,"sj":false,"t":"(İnsanları) Diliyle çekiştiren, kaş ve gözüyle işaretler yapıp alay eden her fesad kişinin vay haline!"},{"n":2,"g":6181,"j":30,"p":601,"sj":false,"t":"O ki mal yığdı, onu saydı durdu."},{"n":3,"g":6182,"j":30,"p":601,"sj":false,"t":"Malının, kendisini ebedi yaşatacağını sanıyor."},{"n":4,"g":6183,"j":30,"p":601,"sj":false,"t":"Hayır, andolsun ki o, Hutame'ye atılacaktır."},{"n":5,"g":6184,"j":30,"p":601,"sj":false,"t":"Hutame'nin ne olduğunu sen nereden bileceksin?"},{"n":6,"g":6185,"j":30,"p":601,"sj":false,"t":"Allah'ın tutuşturulmuş ateşidir."},{"n":7,"g":6186,"j":30,"p":601,"sj":false,"t":"(Bir ateş) Ki gönüllere işler."},{"n":8,"g":6187,"j":30,"p":601,"sj":false,"t":"O, onların üzerine kapatılıp kilitlenecektir."},{"n":9,"g":6188,"j":30,"p":601,"sj":false,"t":"(Kendileri,) Uzatılmış direkler arasında (bağlı) olarak (kalacaklardır)."}]}
