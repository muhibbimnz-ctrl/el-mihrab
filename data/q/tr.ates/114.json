{"n":114,"a":[{"n":1,"g":6231,"j":30,"p":604,"sj":false,"t":"De ki: \"Sığınırım ben, insanların Rabbine."},{"n":2,"g":6232,"j":30,"p":604,"sj":false,"t":"İnsanların padişahına,"},{"n":3,"g":6233,"j":30,"p":604,"sj":false,"t":"İnsanların Tanrısına:"},{"n":4,"g":6234,"j":30,"p":604,"sj":false,"t":"O sinsi vesvesecinin şerrinden."},{"n":5,"g":6235,"j":30,"p":604,"sj":false,"t":"O ki insanların göğüslerine (kötü düşünceler) fısıldar."},{"n":6,"g":6236,"j":30,"p":604,"sj":false,"t":"Gerek cinlerden, gerek insanlardan (olan bütün vesvesecilerin şerrinden Allah'a sığınırım)."}]}
