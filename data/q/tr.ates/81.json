{"n":81,"a":[{"n":1,"g":5801,"j":30,"p":586,"sj":false,"t":"Güneş büzüldüğü zaman,"},{"n":2,"g":5802,"j":30,"p":586,"sj":false,"t":"Yıldızlar kararıp döküldüğü zaman,"},{"n":3,"g":5803,"j":30,"p":586,"sj":false,"t":"Dağlar yürütüldüğü zaman,"},{"n":4,"g":5804,"j":30,"p":586,"sj":false,"t":"On aylık gebe develer başı boş bırakıldığı zaman,"},{"n":5,"g":5805,"j":30,"p":586,"sj":false,"t":"Vahşi hayvanlar bir araya toplandığı zaman,"},{"n":6,"g":5806,"j":30,"p":586,"sj":false,"t":"Denizler kaynatıldığı zaman,"},{"n":7,"g":5807,"j":30,"p":586,"sj":false,"t":"Nefisler çiftleştirildiği zaman."},{"n":8,"g":5808,"j":30,"p":586,"sj":false,"t":"Ve sorulduğu zaman o diri diri toprağa gömülen kıza:"},{"n":9,"g":5809,"j":30,"p":586,"sj":false,"t":"Hangi günah(ı) yüzünden öldürüldü? diye."},{"n":10,"g":5810,"j":30,"p":586,"sj":false,"t":"(Amel) defterler(i) açılıp yayıldığı zaman,"},{"n":11,"g":5811,"j":30,"p":586,"sj":false,"t":"Gök sıyrılıp açıldığı zaman,"},{"n":12,"g":5812,"j":30,"p":586,"sj":false,"t":"Cehennem alevlendirildiği zaman,"},{"n":13,"g":5813,"j":30,"p":586,"sj":false,"t":"Cennet yaklaştırıldığı zaman,"},{"n":14,"g":5814,"j":30,"p":586,"sj":false,"t":"Her can, ne yapıp getirdiğini bilir."},{"n":15,"g":5815,"j":30,"p":586,"sj":false,"t":"Yoo, yemin ederim o geri kalıp gizlenenlere;"},{"n":16,"g":5816,"j":30,"p":586,"sj":false,"t":"Akıp gidenlere, dönüp saklananlara,"},{"n":17,"g":5817,"j":30,"p":586,"sj":false,"t":"Sırtını dönen geceye,"},{"n":18,"g":5818,"j":30,"p":586,"sj":false,"t":"Soluk almağa başlayan sabaha,"},{"n":19,"g":5819,"j":30,"p":586,"sj":false,"t":"(Andolsun bunlara) Ki o, değerli bir elçinin (Cebrail'in) sözüdür."},{"n":20,"g":5820,"j":30,"p":586,"sj":false,"t":"(O elçi,) Güçlüdür, Arşın sahibi (Allah) katında yücedir."},{"n":21,"g":5821,"j":30,"p":586,"sj":false,"t":"Orada (kendisine) ita'at edilen, güvenilendir."},{"n":22,"g":5822,"j":30,"p":586,"sj":false,"t":"Arkadaşınız cinli değildir."},{"n":23,"g":5823,"j":30,"p":586,"sj":false,"t":"Andolsun (Muhammed) onu apaçık ufukta görmüştür."},{"n":24,"g":5824,"j":30,"p":586,"sj":false,"t":"O, gayb hakkında (verdiği haberlerden dolayı) suçlanamaz."},{"n":25,"g":5825,"j":30,"p":586,"sj":false,"t":"O (Kur'an) kovulmuş şeytanın sözü değildir."},{"n":26,"g":5826,"j":30,"p":586,"sj":false,"t":"O halde nereye gidiyorsunuz?"},{"n":27,"g":5827,"j":30,"p":586,"sj":false,"t":"O, alemlere öğüttür."},{"n":28,"g":5828,"j":30,"p":586,"sj":false,"t":"Aranızdan doğru hareket etmek isteyen için;"},{"n":29,"g":5829,"j":30,"p":586,"sj":false,"t":"Alemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz."}]}
