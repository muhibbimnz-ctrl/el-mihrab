{"n":84,"a":[{"n":1,"g":5885,"j":30,"p":589,"sj":false,"t":"Gök yarıldığı,"},{"n":2,"g":5886,"j":30,"p":589,"sj":false,"t":"Kendisine yaraştığı üzere Rabbini(n buyruğunu) dinlediği zaman!"},{"n":3,"g":5887,"j":30,"p":589,"sj":false,"t":"Yer uzatıl(ıp dümdüz yapıl)dığı,"},{"n":4,"g":5888,"j":30,"p":589,"sj":false,"t":"İçindekileri dışarı atıp boşaldığı,"},{"n":5,"g":5889,"j":30,"p":589,"sj":false,"t":"Ve kendisine yaraştığı üzere Rabbini(n buyruğunu) dinlediği zaman!"},{"n":6,"g":5890,"j":30,"p":589,"sj":false,"t":"Ey insan, sen, Rabbine varan yolda çabalayıp durmaktasın, nihayet O'na varacaksın."},{"n":7,"g":5891,"j":30,"p":589,"sj":false,"t":"(O zaman) Kimin Kitabı sağından verilirse:"},{"n":8,"g":5892,"j":30,"p":589,"sj":false,"t":"O, kolay bir hesaba çekilecek,"},{"n":9,"g":5893,"j":30,"p":589,"sj":false,"t":"Ve sevinçli olarak ailesine dönecektir."},{"n":10,"g":5894,"j":30,"p":589,"sj":false,"t":"Kimin Kitabı arka tarafından verilirse."},{"n":11,"g":5895,"j":30,"p":589,"sj":false,"t":"O, ölümü çağıracak,"},{"n":12,"g":5896,"j":30,"p":589,"sj":false,"t":"Ve alevli ateşe girecektir."},{"n":13,"g":5897,"j":30,"p":589,"sj":false,"t":"Çünkü o, (dünyada) ailesi arasında (şımarık ve) sevinçli idi."},{"n":14,"g":5898,"j":30,"p":589,"sj":false,"t":"O, hiç (Rabbine) dönmeyeceğini sanmıştı."},{"n":15,"g":5899,"j":30,"p":589,"sj":false,"t":"Hayır, Rabbi O'nu görmekte idi."},{"n":16,"g":5900,"j":30,"p":589,"sj":false,"t":"Yoo, and içerim; akşamın alaca karanlığına,"},{"n":17,"g":5901,"j":30,"p":589,"sj":false,"t":"Geceye ve (gecenin bağrında) topladığı şeylere,"},{"n":18,"g":5902,"j":30,"p":589,"sj":false,"t":"Değirmileşen aya,"},{"n":19,"g":5903,"j":30,"p":589,"sj":false,"t":"Ki, siz, mutlaka tabakadan tabakaya bineceksiniz!"},{"n":20,"g":5904,"j":30,"p":589,"sj":false,"t":"Onların nesi var ki inanmıyorlar?"},{"n":21,"g":5905,"j":30,"p":589,"sj":true,"t":"Kendilerine Kur'an okunduğu zaman secde etmiyorlar?"},{"n":22,"g":5906,"j":30,"p":589,"sj":false,"t":"Tersine o nankörler yalanlıyorlar."},{"n":23,"g":5907,"j":30,"p":589,"sj":false,"t":"Allah onların, içlerinde gizledikleri (düşünceleri) biliyor."},{"n":24,"g":5908,"j":30,"p":589,"sj":false,"t":"Onlara acı bir azabı müjdele."},{"n":25,"g":5909,"j":30,"p":589,"sj":false,"t":"Ancak inanıp yararlı işler yapan kimseler için kesintisiz bir mükafat vardır."}]}
