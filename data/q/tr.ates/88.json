{"n":88,"a":[{"n":1,"g":5968,"j":30,"p":592,"sj":false,"t":"(Şiddet ve dehşetiyle her şeyi) Sarıp kaplayacak olan(o felaket)in haberi sana geldi mi?"},{"n":2,"g":5969,"j":30,"p":592,"sj":false,"t":"Yüzler var ki o gün öne düşüktür,"},{"n":3,"g":5970,"j":30,"p":592,"sj":false,"t":"Çalışır, yorulur."},{"n":4,"g":5971,"j":30,"p":592,"sj":false,"t":"Kızgın ateşe girerler."},{"n":5,"g":5972,"j":30,"p":592,"sj":false,"t":"Kendilerine kaynamış bir gözeden (su) içirilir."},{"n":6,"g":5973,"j":30,"p":592,"sj":false,"t":"Onlar için kuru dikenden başka yiyecek de yoktur."},{"n":7,"g":5974,"j":30,"p":592,"sj":false,"t":"O da ne semirtir, ne de açlığı giderir."},{"n":8,"g":5975,"j":30,"p":592,"sj":false,"t":"Yüzler de var ki o gün ni'met içinde mutlu,"},{"n":9,"g":5976,"j":30,"p":592,"sj":false,"t":"İşinden memnun,"},{"n":10,"g":5977,"j":30,"p":592,"sj":false,"t":"Yüksek bir bahçededir."},{"n":11,"g":5978,"j":30,"p":592,"sj":false,"t":"Orada boş söz işitmezler."},{"n":12,"g":5979,"j":30,"p":592,"sj":false,"t":"Orada akan bir kaynak vardır."},{"n":13,"g":5980,"j":30,"p":592,"sj":false,"t":"Orada yükseltilmiş tahtlar,"},{"n":14,"g":5981,"j":30,"p":592,"sj":false,"t":"Konulmuş kadehler,"},{"n":15,"g":5982,"j":30,"p":592,"sj":false,"t":"Dizilmiş yastıklar,"},{"n":16,"g":5983,"j":30,"p":592,"sj":false,"t":"Serilmiş halılar vardır."},{"n":17,"g":5984,"j":30,"p":592,"sj":false,"t":"Bakmıyorlar mı develere, nasıl yaratılmış?"},{"n":18,"g":5985,"j":30,"p":592,"sj":false,"t":"Göğe, nasıl yükseltilmiş?"},{"n":19,"g":5986,"j":30,"p":592,"sj":false,"t":"Dağlara, nasıl dikilmiş?"},{"n":20,"g":5987,"j":30,"p":592,"sj":false,"t":"Yere, nasıl yayılıp döşenmiş?"},{"n":21,"g":5988,"j":30,"p":592,"sj":false,"t":"Öğüt ver, çünkü sen ancak öğüt verensin."},{"n":22,"g":5989,"j":30,"p":592,"sj":false,"t":"Onların üzerinde zorlayıcı değilsin."},{"n":23,"g":5990,"j":30,"p":592,"sj":false,"t":"Ancak kim yüz çevirir ve inanmazsa,"},{"n":24,"g":5991,"j":30,"p":592,"sj":false,"t":"Allah ona en büyük azabı eder,"},{"n":25,"g":5992,"j":30,"p":592,"sj":false,"t":"Dönüşleri Bizedir."},{"n":26,"g":5993,"j":30,"p":592,"sj":false,"t":"Sonra onların hesabını görmek Bize düşer."}]}
