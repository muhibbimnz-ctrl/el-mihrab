{"n":91,"a":[{"n":1,"g":6044,"j":30,"p":595,"sj":false,"t":"Güneşe ve onun aydın sabahına andolsun,"},{"n":2,"g":6045,"j":30,"p":595,"sj":false,"t":"Onu izleyen aya andolsun,"},{"n":3,"g":6046,"j":30,"p":595,"sj":false,"t":"Güneşi ortaya çıkaran gündüze andolsun."},{"n":4,"g":6047,"j":30,"p":595,"sj":false,"t":"Onu örten geceye andolsun."},{"n":5,"g":6048,"j":30,"p":595,"sj":false,"t":"Göğe ve onu yapana andolsun."},{"n":6,"g":6049,"j":30,"p":595,"sj":false,"t":"Yere ve onu yuvarlayıp döşeyene andolsun."},{"n":7,"g":6050,"j":30,"p":595,"sj":false,"t":"Nefse ve onu biçimlendirene,"},{"n":8,"g":6051,"j":30,"p":595,"sj":false,"t":"Ona bozukluğunu ve korunmasını (isyanını ve ita'atini) ilham edene andolsun ki:"},{"n":9,"g":6052,"j":30,"p":595,"sj":false,"t":"(Allah'tan başkasına tapmayarak) Nefsini yücelten kazanmış,"},{"n":10,"g":6053,"j":30,"p":595,"sj":false,"t":"(Yaratıklara taparak) Onu alçaltan da ziyana uğramıştır."},{"n":11,"g":6054,"j":30,"p":595,"sj":false,"t":"Semud (kavmi), azgınlığı yüzünden (Hakk'ı) yalanladı."},{"n":12,"g":6055,"j":30,"p":595,"sj":false,"t":"En haydutları ayaklandığı zaman,"},{"n":13,"g":6056,"j":30,"p":595,"sj":false,"t":"Allah'ın elçisi onlara: \"Allah'ın devesine ve onun su içme hakkına dokunmayın!\" demişti."},{"n":14,"g":6057,"j":30,"p":595,"sj":false,"t":"Onu yalanladılar, deveyi kestiler. Rableri de, günahları yüzünden azabı başlarına geçirip, orayı dümdüz etti."},{"n":15,"g":6058,"j":30,"p":595,"sj":false,"t":"(Rab) Bu işin sonundan korkmaz."}]}
