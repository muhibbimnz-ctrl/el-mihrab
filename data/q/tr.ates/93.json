{"n":93,"a":[{"n":1,"g":6080,"j":30,"p":596,"sj":false,"t":"Kuşluk vaktine andolsun,"},{"n":2,"g":6081,"j":30,"p":596,"sj":false,"t":"Sakinleşen geceye andolsun ki,"},{"n":3,"g":6082,"j":30,"p":596,"sj":false,"t":"Rabbin, seni bırakmadı ve sana darılmadı."},{"n":4,"g":6083,"j":30,"p":596,"sj":false,"t":"Senin sonun, ilkinden iyi olacaktır."},{"n":5,"g":6084,"j":30,"p":596,"sj":false,"t":"Rabbin, sana verecek ve sen razı olacaksın."},{"n":6,"g":6085,"j":30,"p":596,"sj":false,"t":"O, seni yetim bulup barındırmadı mı?"},{"n":7,"g":6086,"j":30,"p":596,"sj":false,"t":"Seni şaşırmış bulup yola iletmedi mi?"},{"n":8,"g":6087,"j":30,"p":596,"sj":false,"t":"Seni fakir bulup zengin etmedi mi?"},{"n":9,"g":6088,"j":30,"p":596,"sj":false,"t":"Öyleyse sakın öksüzü ezme,"},{"n":10,"g":6089,"j":30,"p":596,"sj":false,"t":"Dilenciyi azarlama."},{"n":11,"g":6090,"j":30,"p":596,"sj":false,"t":"Ve Rabbinin ni'metini anlat."}]}
