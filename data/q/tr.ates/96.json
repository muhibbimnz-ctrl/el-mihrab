{"n":96,"a":[{"n":1,"g":6107,"j":30,"p":597,"sj":false,"t":"Yaratan Rabbinin adıyle oku."},{"n":2,"g":6108,"j":30,"p":597,"sj":false,"t":"O, insanı alaktan (embriyodan) yarattı."},{"n":3,"g":6109,"j":30,"p":597,"sj":false,"t":"Oku, Rabbin en büyük kerem sahibidir."},{"n":4,"g":6110,"j":30,"p":597,"sj":false,"t":"O ki kalemle (yazmayı) öğretti."},{"n":5,"g":6111,"j":30,"p":597,"sj":false,"t":"İnsana bilmediğini öğretti."},{"n":6,"g":6112,"j":30,"p":597,"sj":false,"t":"Hayır, (Rabbinin bu kadar iyiliğine rağmen yine) insan azar;"},{"n":7,"g":6113,"j":30,"p":597,"sj":false,"t":"Kendini zengin (kendine yeterli) gördüğü için,"},{"n":8,"g":6114,"j":30,"p":597,"sj":false,"t":"Ama dönüş Rabbinedir (O'nun huzurunda bu azgınlığının hesabını verecektir)."},{"n":9,"g":6115,"j":30,"p":597,"sj":false,"t":"Gördün mü şu men'edeni?"},{"n":10,"g":6116,"j":30,"p":597,"sj":false,"t":"Namaz kılarken bir kulu (namazdan)?"},{"n":11,"g":6117,"j":30,"p":597,"sj":false,"t":"Gördün mü, ya o (kul) doğru yolda olur,"},{"n":12,"g":6118,"j":30,"p":597,"sj":false,"t":"Yahut kötülüklerden korunmayı emrederse?"},{"n":13,"g":6119,"j":30,"p":597,"sj":false,"t":"Gördün mü, ya bu (adam, hakkı) yalanlar yüz çevirirse? (O zaman bu yaptığı kendisi için iyi mi olur?)"},{"n":14,"g":6120,"j":30,"p":597,"sj":false,"t":"Allah'ın (daima kendisini) gördüğünü bilmedi mi (o)?"},{"n":15,"g":6121,"j":30,"p":597,"sj":false,"t":"Hayır, (olmaz böyle şey), eğer bundan vazgeçmezse (onu) perçem(in)den yakalar(ateşe sürükler)iz,"},{"n":16,"g":6122,"j":30,"p":597,"sj":false,"t":"O yalancı, günahkar perçem(den)!"},{"n":17,"g":6123,"j":30,"p":597,"sj":false,"t":"O zaman (o gitsin) de meclisini (adamlarını) çağırsın."},{"n":18,"g":6124,"j":30,"p":597,"sj":false,"t":"Biz de zebanileri çağıracağız."},{"n":19,"g":6125,"j":30,"p":597,"sj":true,"t":"Hayır, ona boyun eğme; (Rabbine) secde et ve yaklaş!"}]}
