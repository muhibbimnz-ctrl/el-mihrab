{"n":100,"a":[{"n":1,"g":6147,"j":30,"p":599,"sj":false,"t":"Soluk soluğa koşan (at)lara andolsun,"},{"n":2,"g":6148,"j":30,"p":599,"sj":false,"t":"(Tırnaklarıyla) Ateş saçanlara,"},{"n":3,"g":6149,"j":30,"p":599,"sj":false,"t":"Sabah vakti baskın yapanlara."},{"n":4,"g":6150,"j":30,"p":599,"sj":false,"t":"Derken, orada tozu dumana katanlara,"},{"n":5,"g":6151,"j":30,"p":599,"sj":false,"t":"Bununla bir (düşman) topluluğun orta yerine kadar dalanlara."},{"n":6,"g":6152,"j":30,"p":599,"sj":false,"t":"Gerçekten insan, Rabbine karşı nankördür."},{"n":7,"g":6153,"j":30,"p":599,"sj":false,"t":"Ve gerçekten, kendisi buna şahiddir."},{"n":8,"g":6154,"j":30,"p":599,"sj":false,"t":"Muhakkak o, mal sevgisinden dolayı (bencil ve cimri tutumundan) çok katıdır."},{"n":9,"g":6155,"j":30,"p":599,"sj":false,"t":"Yine de bilmeyecek mi? Kabirlerde olanların 'deşilip dışa atıldığı,'"},{"n":10,"g":6156,"j":30,"p":600,"sj":false,"t":"Göğüslerde olanların derlenip-devşirildiği zamanı?"},{"n":11,"g":6157,"j":30,"p":600,"sj":false,"t":"Şüphesiz, o gün Rableri, kendilerinden gerçekten haberdardır."}]}
