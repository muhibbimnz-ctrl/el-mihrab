{"n":101,"a":[{"n":1,"g":6158,"j":30,"p":600,"sj":false,"t":"Kaari’a..."},{"n":2,"g":6159,"j":30,"p":600,"sj":false,"t":"Nedir kaari’a?"},{"n":3,"g":6160,"j":30,"p":600,"sj":false,"t":"Sana o kaaria’yı bildiren nedir?"},{"n":4,"g":6161,"j":30,"p":600,"sj":false,"t":"İnsanların, 'her yana dağılmış' pervaneler gibi olacakları gün,"},{"n":5,"g":6162,"j":30,"p":600,"sj":false,"t":"Ve dağların 'etrafa saçılmış' renkli yünler gibi olacakları (gün),"},{"n":6,"g":6163,"j":30,"p":600,"sj":false,"t":"İşte, kimin tartıları ağır basarsa,"},{"n":7,"g":6164,"j":30,"p":600,"sj":false,"t":"Artık o, hoşnut olunan bir hayat içindedir."},{"n":8,"g":6165,"j":30,"p":600,"sj":false,"t":"Kimin tartıları hafif kalırsa,"},{"n":9,"g":6166,"j":30,"p":600,"sj":false,"t":"Artık onun da anası (son durağı) \"haviye\"dir (uçurum)."},{"n":10,"g":6167,"j":30,"p":600,"sj":false,"t":"Onun ne olduğunu (mahiyetini) sana bildiren nedir?"},{"n":11,"g":6168,"j":30,"p":600,"sj":false,"t":"O, kızgın bir ateştir."}]}
