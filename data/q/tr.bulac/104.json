{"n":104,"a":[{"n":1,"g":6180,"j":30,"p":601,"sj":false,"t":"Arkadan çekiştirip duran, kaş göz hareketleriyle alay eden her kişinin vay haline;"},{"n":2,"g":6181,"j":30,"p":601,"sj":false,"t":"Ki o, mal yığıp biriktiren ve onu saydıkça sayandır."},{"n":3,"g":6182,"j":30,"p":601,"sj":false,"t":"Gerçekten malının kendisini ebedi kılacağını sanıyor."},{"n":4,"g":6183,"j":30,"p":601,"sj":false,"t":"Hayır; andolsun o, 'hutame'ye atılacaktır."},{"n":5,"g":6184,"j":30,"p":601,"sj":false,"t":"\"Hutame\"nin ne olduğunu sana bildiren nedir?"},{"n":6,"g":6185,"j":30,"p":601,"sj":false,"t":"Allah'ın tutuşturulmuş ateşidir."},{"n":7,"g":6186,"j":30,"p":601,"sj":false,"t":"Ki o, yüreklerin üstüne tırmanıp çıkar."},{"n":8,"g":6187,"j":30,"p":601,"sj":false,"t":"O, onların üzerine kilitlenecektir;"},{"n":9,"g":6188,"j":30,"p":601,"sj":false,"t":"(Kendileri de) Dikilip-yükseltilmiş sütunlarda (bağlanacaklardır)."}]}
