{"n":77,"a":[{"n":1,"g":5623,"j":29,"p":580,"sj":false,"t":"Birbiri ardınca gönderilenlere andolsun;"},{"n":2,"g":5624,"j":29,"p":580,"sj":false,"t":"Derken kökünden koparıp savuranlara."},{"n":3,"g":5625,"j":29,"p":580,"sj":false,"t":"Yaydıkça yayanlara."},{"n":4,"g":5626,"j":29,"p":580,"sj":false,"t":"Böylece ayırdıkça ayıranlara,"},{"n":5,"g":5627,"j":29,"p":580,"sj":false,"t":"Zikr (vahy, öğüt) bırakanlara;"},{"n":6,"g":5628,"j":29,"p":580,"sj":false,"t":"Özür (suçu, eksikliği ortadan kaldırmak) veya uyarmak için."},{"n":7,"g":5629,"j":29,"p":580,"sj":false,"t":"Şüphesiz, size vaadedilen gerçekleşecektir."},{"n":8,"g":5630,"j":29,"p":580,"sj":false,"t":"Yıldızlar 'örtülüp (ışıkları) silindiği' zaman,"},{"n":9,"g":5631,"j":29,"p":580,"sj":false,"t":"Gök yarıldığı zaman"},{"n":10,"g":5632,"j":29,"p":580,"sj":false,"t":"Dağlar, kökünden sökülüp savurulduğu zaman,"},{"n":11,"g":5633,"j":29,"p":580,"sj":false,"t":"Ve resuller de (şahitlik için) belli bir vakitte getirildiği zaman"},{"n":12,"g":5634,"j":29,"p":580,"sj":false,"t":"(Bu,) Hangi gün için ertelenmişti?"},{"n":13,"g":5635,"j":29,"p":580,"sj":false,"t":"(Mü'mini müşrikten, haklıyı haksızdan) Ayırma günü için."},{"n":14,"g":5636,"j":29,"p":580,"sj":false,"t":"Bu ayırma gününü sana ne bildirdi?"},{"n":15,"g":5637,"j":29,"p":580,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":16,"g":5638,"j":29,"p":580,"sj":false,"t":"Biz, öncekileri helak etmedik mi?"},{"n":17,"g":5639,"j":29,"p":580,"sj":false,"t":"Sonra arkadan gelenleri onların izinde yürüteceğiz."},{"n":18,"g":5640,"j":29,"p":580,"sj":false,"t":"İşte Biz, suçlu-günahkarlara böyle yapıyoruz."},{"n":19,"g":5641,"j":29,"p":580,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":20,"g":5642,"j":29,"p":581,"sj":false,"t":"Sizi basbayağı bir sudan yaratmadık mı?"},{"n":21,"g":5643,"j":29,"p":581,"sj":false,"t":"Sonra onu savunması sağlam bir karar yerine yerleştirdik."},{"n":22,"g":5644,"j":29,"p":581,"sj":false,"t":"Belli bir süreye kadar;"},{"n":23,"g":5645,"j":29,"p":581,"sj":false,"t":"İşte (buna) güç yetirdik. Demek ki, Biz ne güzel güç yetirenleriz."},{"n":24,"g":5646,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":25,"g":5647,"j":29,"p":581,"sj":false,"t":"Biz yeryüzünü bir toplanma yeri kılmadık mı?"},{"n":26,"g":5648,"j":29,"p":581,"sj":false,"t":"Dirilere ve ölülere."},{"n":27,"g":5649,"j":29,"p":581,"sj":false,"t":"Ve onda sabit yüksek dağlar var etmedik mi? Size tatlı bir su içirmedik mi?"},{"n":28,"g":5650,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":29,"g":5651,"j":29,"p":581,"sj":false,"t":"Kendisini yalanladığınız (azab)a gidin."},{"n":30,"g":5652,"j":29,"p":581,"sj":false,"t":"Üç dala ayrılmış bir gölgeye gidin."},{"n":31,"g":5653,"j":29,"p":581,"sj":false,"t":"Ne gölge altında barındırır, ne (yakıcı) alevden korur."},{"n":32,"g":5654,"j":29,"p":581,"sj":false,"t":"Gerçekten o, sanki her biri saray olan bir kıvılcım saçar."},{"n":33,"g":5655,"j":29,"p":581,"sj":false,"t":"Her biri, sanki sapsarı erkek deve sürüleri gibidir."},{"n":34,"g":5656,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":35,"g":5657,"j":29,"p":581,"sj":false,"t":"Bu, onların konuşamayacakları bir gündür."},{"n":36,"g":5658,"j":29,"p":581,"sj":false,"t":"Ve onlara özür beyan etmeleri için izin verilmez."},{"n":37,"g":5659,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":38,"g":5660,"j":29,"p":581,"sj":false,"t":"Bu, hüküm günüdür; sizi ve öncekileri 'birarada topladık.'"},{"n":39,"g":5661,"j":29,"p":581,"sj":false,"t":"Şayet kurabileceğiniz hileli bir düzeniniz varsa, durmaksızın bana karşı kurun."},{"n":40,"g":5662,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":41,"g":5663,"j":29,"p":581,"sj":false,"t":"Şüphesiz muttaki olanlar, gölgeliklerde ve pınar-başlarındadır;"},{"n":42,"g":5664,"j":29,"p":581,"sj":false,"t":"Ve canlarının çekip-arzu ettiği meyveler (arasındadırlar)."},{"n":43,"g":5665,"j":29,"p":581,"sj":false,"t":"Yaptıklarınıza karşılık olmak üzere, afiyetle yiyin ve için."},{"n":44,"g":5666,"j":29,"p":581,"sj":false,"t":"Elbette Biz, 'iyi ve güzel' davrananları işte böyle ödüllendiririz."},{"n":45,"g":5667,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":46,"g":5668,"j":29,"p":581,"sj":false,"t":"(Sizler de dünyada) Yiyin ve biraz yararlanın. Çünkü siz, suçlu-günahkar kimselersiniz."},{"n":47,"g":5669,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":48,"g":5670,"j":29,"p":581,"sj":false,"t":"Onlara: \"Rüku edin\" denildiği zaman, rüku etmezler."},{"n":49,"g":5671,"j":29,"p":581,"sj":false,"t":"O gün, yalanlayanların vay haline."},{"n":50,"g":5672,"j":29,"p":581,"sj":false,"t":"Artık onlar, bundan sonra hangi söze inanacaklar?"}]}
