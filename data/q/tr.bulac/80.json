{"n":80,"a":[{"n":1,"g":5759,"j":30,"p":585,"sj":false,"t":"Surat astı ve yüz çevirdi;"},{"n":2,"g":5760,"j":30,"p":585,"sj":false,"t":"Kendisine o kör geldi diye."},{"n":3,"g":5761,"j":30,"p":585,"sj":false,"t":"Nerden biliyorsun; belki o, temizlenip-arınacak?"},{"n":4,"g":5762,"j":30,"p":585,"sj":false,"t":"Veya öğüt alacak; böylelikle bu öğüt kendisine yarar sağlayacak."},{"n":5,"g":5763,"j":30,"p":585,"sj":false,"t":"Fakat kendini müstağni gören (hiçbir şeye ihtiyacı olmadığını sanan) ise,"},{"n":6,"g":5764,"j":30,"p":585,"sj":false,"t":"İşte sen, onda 'yankı uyandırmaya’ çalışıyorsun."},{"n":7,"g":5765,"j":30,"p":585,"sj":false,"t":"Oysa, onun temizlenip-arınmasından sana ne?"},{"n":8,"g":5766,"j":30,"p":585,"sj":false,"t":"Ama koşarak sana gelen ise,"},{"n":9,"g":5767,"j":30,"p":585,"sj":false,"t":"Ki o, 'içi titreyerek korkar' bir durumdadır;"},{"n":10,"g":5768,"j":30,"p":585,"sj":false,"t":"Sen ona aldırış etmeden oyalanıyorsun."},{"n":11,"g":5769,"j":30,"p":585,"sj":false,"t":"Hayır; çünkü o (Kur'an), bir öğüttür."},{"n":12,"g":5770,"j":30,"p":585,"sj":false,"t":"Artık dileyen, onu 'düşünüp-öğüt alsın.'"},{"n":13,"g":5771,"j":30,"p":585,"sj":false,"t":"O (Kur'an), 'şerefli-üstün' sahifelerdedir."},{"n":14,"g":5772,"j":30,"p":585,"sj":false,"t":"Yüceltilmiş, tertemiz (mutahhar) kılınmış."},{"n":15,"g":5773,"j":30,"p":585,"sj":false,"t":"Katiplerin ellerinde."},{"n":16,"g":5774,"j":30,"p":585,"sj":false,"t":"(Ki onlar,) Üstün değerli, 'iyilik ve dürüstlük sembolü.'"},{"n":17,"g":5775,"j":30,"p":585,"sj":false,"t":"Kahrolası insan, ne kadar nankördür."},{"n":18,"g":5776,"j":30,"p":585,"sj":false,"t":"(Allah) Onu hangi şeyden yarattı?"},{"n":19,"g":5777,"j":30,"p":585,"sj":false,"t":"Bir damla sudan yarattı da onu 'bir ölçüyle biçime soktu.'"},{"n":20,"g":5778,"j":30,"p":585,"sj":false,"t":"Sonra ona yolu kolaylaştırdı."},{"n":21,"g":5779,"j":30,"p":585,"sj":false,"t":"Sonra onu öldürdü, böylece kabre gömdürdü."},{"n":22,"g":5780,"j":30,"p":585,"sj":false,"t":"Sonra dilediği zaman onu diriltir."},{"n":23,"g":5781,"j":30,"p":585,"sj":false,"t":"Hayır; ona (Allah'ın) emrettiğini yerine getirmedi."},{"n":24,"g":5782,"j":30,"p":585,"sj":false,"t":"Bir de insan, yediğine bir bakıversin;"},{"n":25,"g":5783,"j":30,"p":585,"sj":false,"t":"Biz şüphesiz, suyu akıttıkça akıttık,"},{"n":26,"g":5784,"j":30,"p":585,"sj":false,"t":"Sonra yeri yardıkça yardık;"},{"n":27,"g":5785,"j":30,"p":585,"sj":false,"t":"Böylece onda taneler bitirdik,"},{"n":28,"g":5786,"j":30,"p":585,"sj":false,"t":"Üzümler, yoncalar,"},{"n":29,"g":5787,"j":30,"p":585,"sj":false,"t":"Zeytinler, hurmalar,"},{"n":30,"g":5788,"j":30,"p":585,"sj":false,"t":"Boyları birbiriyle yarışan ve içiçe girmiş ağaçlı bahçeler."},{"n":31,"g":5789,"j":30,"p":585,"sj":false,"t":"Meyveler ve otlaklıklar,"},{"n":32,"g":5790,"j":30,"p":585,"sj":false,"t":"Size ve hayvanlarınıza bir yarar (meta) olmak üzere."},{"n":33,"g":5791,"j":30,"p":585,"sj":false,"t":"Fakat 'kulakları patlatırcasına olan o gürleme' geldiği zaman,"},{"n":34,"g":5792,"j":30,"p":585,"sj":false,"t":"Kişi o gün, kendi kardeşinden kaçar;"},{"n":35,"g":5793,"j":30,"p":585,"sj":false,"t":"Annesinden ve babasından,"},{"n":36,"g":5794,"j":30,"p":585,"sj":false,"t":"Eşinden ve çocuklarından,"},{"n":37,"g":5795,"j":30,"p":585,"sj":false,"t":"O gün, onlardan her birisinin kendine yetecek bir işi vardır."},{"n":38,"g":5796,"j":30,"p":585,"sj":false,"t":"O gün, öyle yüzler vardır ki apaydınlıktır;"},{"n":39,"g":5797,"j":30,"p":585,"sj":false,"t":"Güler ve sevinç içindedir."},{"n":40,"g":5798,"j":30,"p":585,"sj":false,"t":"Ve o gün, öyle yüzler de vardır ki üzerini toz bürümüştür."},{"n":41,"g":5799,"j":30,"p":585,"sj":false,"t":"Bir karartı sarıp-kaplamıştır."},{"n":42,"g":5800,"j":30,"p":585,"sj":false,"t":"İşte onlar da, kafir, facir olanlardır."}]}
