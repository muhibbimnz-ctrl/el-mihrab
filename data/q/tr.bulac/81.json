{"n":81,"a":[{"n":1,"g":5801,"j":30,"p":586,"sj":false,"t":"Güneş, köreltildiği zaman,"},{"n":2,"g":5802,"j":30,"p":586,"sj":false,"t":"Yıldızlar, bulanıklaşıp-döküldüğü zaman,"},{"n":3,"g":5803,"j":30,"p":586,"sj":false,"t":"Dağlar, yürütüldüğü zaman,"},{"n":4,"g":5804,"j":30,"p":586,"sj":false,"t":"Gebe develer, kendi başına terk edildiği zaman,"},{"n":5,"g":5805,"j":30,"p":586,"sj":false,"t":"Vahşi-hayvanlar, toplandığı zaman,"},{"n":6,"g":5806,"j":30,"p":586,"sj":false,"t":"Denizler, tutuşturulduğu zaman,"},{"n":7,"g":5807,"j":30,"p":586,"sj":false,"t":"Nefisler, birleştiği zaman,"},{"n":8,"g":5808,"j":30,"p":586,"sj":false,"t":"Ve 'diri diri toprağa gömülen kızcağıza' sorulduğu zaman:"},{"n":9,"g":5809,"j":30,"p":586,"sj":false,"t":"\"Hangi suçtan dolayı öldürüldü?\""},{"n":10,"g":5810,"j":30,"p":586,"sj":false,"t":"Sahifeler (amel defterleri) açıldığı zaman,"},{"n":11,"g":5811,"j":30,"p":586,"sj":false,"t":"Gök, sıyrılıp-yüzüldüğü zaman"},{"n":12,"g":5812,"j":30,"p":586,"sj":false,"t":"Cehennem ateşi çılgınca kızıştırıldığı zaman,"},{"n":13,"g":5813,"j":30,"p":586,"sj":false,"t":"Cennet de yakınlaştırıldığı zaman,"},{"n":14,"g":5814,"j":30,"p":586,"sj":false,"t":"(Artık her) Nefis, neyi hazırladığını bilip-öğrenmiştir."},{"n":15,"g":5815,"j":30,"p":586,"sj":false,"t":"Artık hayır; yemin ederim (gündüz) sinip (gece) dönen (gezegen)lere,"},{"n":16,"g":5816,"j":30,"p":586,"sj":false,"t":"Bir akış içinde yerini alanlara;"},{"n":17,"g":5817,"j":30,"p":586,"sj":false,"t":"Kararmaya ilk başladığı zaman, geceye andolsun,"},{"n":18,"g":5818,"j":30,"p":586,"sj":false,"t":"Ve nefes almaya başladığı zaman, sabaha;"},{"n":19,"g":5819,"j":30,"p":586,"sj":false,"t":"Şüphesiz o (Kur'an), üstün onur sahibi bir elçinin gerçekten (Allah'tan getirdiği) sözüdür;"},{"n":20,"g":5820,"j":30,"p":586,"sj":false,"t":"(Bu elçi,) Bir güç sahibidir, arşın sahibi Katında şereflidir."},{"n":21,"g":5821,"j":30,"p":586,"sj":false,"t":"Ona itaat edilir, sonra güvenilirdir."},{"n":22,"g":5822,"j":30,"p":586,"sj":false,"t":"Sizin sahibiniz bir deli değildir."},{"n":23,"g":5823,"j":30,"p":586,"sj":false,"t":"Andolsun o (peygamber), onu apaçık bir ufukta görmüştür."},{"n":24,"g":5824,"j":30,"p":586,"sj":false,"t":"O, gayb (haberlerin)e karşı (söylediklerinden dolayı) suçlanamaz (ya da cimrilikte bulunup kıskançlık yapmaz.)"},{"n":25,"g":5825,"j":30,"p":586,"sj":false,"t":"O (Kur'an) da kovulmuş şeytanın sözü değildir."},{"n":26,"g":5826,"j":30,"p":586,"sj":false,"t":"Şu halde, siz nereye kaçıp-gidiyorsunuz?"},{"n":27,"g":5827,"j":30,"p":586,"sj":false,"t":"O (Kur'an), alemler için yalnızca bir zikirdir;"},{"n":28,"g":5828,"j":30,"p":586,"sj":false,"t":"Sizden dosdoğru bir yön (istikamet) tutturmak dileyenler için."},{"n":29,"g":5829,"j":30,"p":586,"sj":false,"t":"Alemlerin Rabbi olan Allah dilemedikçe siz dileyemezsiniz."}]}
