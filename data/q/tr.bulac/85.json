{"n":85,"a":[{"n":1,"g":5910,"j":30,"p":590,"sj":false,"t":"Burçları olan göğe andolsun,"},{"n":2,"g":5911,"j":30,"p":590,"sj":false,"t":"O vadedilen güne,"},{"n":3,"g":5912,"j":30,"p":590,"sj":false,"t":"Şahid olana (görene) ve şahit olunana (görülene)."},{"n":4,"g":5913,"j":30,"p":590,"sj":false,"t":"Kahrolsun Ashab-ı Uhdud"},{"n":5,"g":5914,"j":30,"p":590,"sj":false,"t":"'Tutuşturucu-yakıt dolu o ateş,'"},{"n":6,"g":5915,"j":30,"p":590,"sj":false,"t":"Hani kendileri (ateş hendeğinin) çevresinde oturmuşlardı."},{"n":7,"g":5916,"j":30,"p":590,"sj":false,"t":"Ve mü'minlere yaptıklarını seyrediyorlardı."},{"n":8,"g":5917,"j":30,"p":590,"sj":false,"t":"Onlardan, yalnızca 'üstün ve güçlü olan,' öğülen Allah'a iman ettiklerinden dolayı intikam alıyorlardı."},{"n":9,"g":5918,"j":30,"p":590,"sj":false,"t":"Ki O (Allah), göklerin ve yerin mülkü O'nundur. Allah, herşeyin üzerinde şahid olandır."},{"n":10,"g":5919,"j":30,"p":590,"sj":false,"t":"Gerçek şu ki, mü'min erkeklerle mü'min kadınlara işkence (fitne) uygulayanlar, sonra tevbe etmeyenler; işte onlar için, cehennem azabı vardır ve yakıcı azap onlaradır."},{"n":11,"g":5920,"j":30,"p":590,"sj":false,"t":"Şüphesiz iman edip salih amellerde bulunanlara gelince; onlar için altından ırmaklar akan cennetler vardır. İşte büyük 'kurtuluş ve mutluluk' budur."},{"n":12,"g":5921,"j":30,"p":590,"sj":false,"t":"Doğrusu, Rabbinin 'zorlu yakalayışı' şiddetlidir."},{"n":13,"g":5922,"j":30,"p":590,"sj":false,"t":"Çünkü O, ilkin var eden, (sonra dirilterek) döndürecek olandır."},{"n":14,"g":5923,"j":30,"p":590,"sj":false,"t":"O, çok bağışlayandır, çok sevendir."},{"n":15,"g":5924,"j":30,"p":590,"sj":false,"t":"Arşın sahibidir; Mecid (pek Yüce)dir."},{"n":16,"g":5925,"j":30,"p":590,"sj":false,"t":"Her dilediğini yapıp-gerçekleştirendir."},{"n":17,"g":5926,"j":30,"p":590,"sj":false,"t":"Orduların haberi sana geldi mi?"},{"n":18,"g":5927,"j":30,"p":590,"sj":false,"t":"Firavun ve Semud (ordularının)?"},{"n":19,"g":5928,"j":30,"p":590,"sj":false,"t":"Hayır; inkar edenler, (kesintisiz) bir yalanlama içindedirler."},{"n":20,"g":5929,"j":30,"p":590,"sj":false,"t":"Allah ise, onları arkalarından sarıp-kuşatmıştır."},{"n":21,"g":5930,"j":30,"p":590,"sj":false,"t":"Hayır; o (Kitap), 'şerefli-üstün' olan bir Kur'an'dır;"},{"n":22,"g":5931,"j":30,"p":590,"sj":false,"t":"Levh-i Mahfuz'dadır."}]}
