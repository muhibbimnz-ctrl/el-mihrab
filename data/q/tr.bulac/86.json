{"n":86,"a":[{"n":1,"g":5932,"j":30,"p":591,"sj":false,"t":"Göğe ve Tarık'a andolsun,"},{"n":2,"g":5933,"j":30,"p":591,"sj":false,"t":"Tarık'ın ne olduğunu sana bildiren nedir?"},{"n":3,"g":5934,"j":30,"p":591,"sj":false,"t":"(Karanlığı) Delen yıldızdır."},{"n":4,"g":5935,"j":30,"p":591,"sj":false,"t":"Üzerinde gözetleyici-koruyucu bulunmayan hiçbir nefis (kimse) yoktur."},{"n":5,"g":5936,"j":30,"p":591,"sj":false,"t":"İnsan bir baksın, hangi şeyden yaratıldı?"},{"n":6,"g":5937,"j":30,"p":591,"sj":false,"t":"Dökülüp atılan bir sudan yaratıldı."},{"n":7,"g":5938,"j":30,"p":591,"sj":false,"t":"(Bu su,) Bel kemiği ile kaburgalar arasında(ki organlar)dan çıkar."},{"n":8,"g":5939,"j":30,"p":591,"sj":false,"t":"Şüphesiz (Allah), onu yeniden-döndürmeye güç yetirendir."},{"n":9,"g":5940,"j":30,"p":591,"sj":false,"t":"Sırların orta yere çıkarılacağı gün;"},{"n":10,"g":5941,"j":30,"p":591,"sj":false,"t":"Artık onun ne gücü vardır, ne yardımcısı."},{"n":11,"g":5942,"j":30,"p":591,"sj":false,"t":"Dönüşlü olan göğe andolsun."},{"n":12,"g":5943,"j":30,"p":591,"sj":false,"t":"Yarılan yere de."},{"n":13,"g":5944,"j":30,"p":591,"sj":false,"t":"Şüphesiz o (Kur'an), ayırdeden bir sözdür."},{"n":14,"g":5945,"j":30,"p":591,"sj":false,"t":"O, bir şaka değildir."},{"n":15,"g":5946,"j":30,"p":591,"sj":false,"t":"Doğrusu onlar, hileli bir düzen planlayıp kuruyorlar;"},{"n":16,"g":5947,"j":30,"p":591,"sj":false,"t":"Ben de bir düzen kurup hazırlıyorum."},{"n":17,"g":5948,"j":30,"p":591,"sj":false,"t":"Sen kafirlere bir mühlet ver, az bir süre tanı."}]}
