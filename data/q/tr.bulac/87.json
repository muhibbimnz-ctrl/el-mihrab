{"n":87,"a":[{"n":1,"g":5949,"j":30,"p":591,"sj":false,"t":"Rabbinin Yüce ismini tesbih et,"},{"n":2,"g":5950,"j":30,"p":591,"sj":false,"t":"Ki O, yarattı, 'bir düzen içinde biçim verdi',"},{"n":3,"g":5951,"j":30,"p":591,"sj":false,"t":"Takdir etti, böylece yol gösterdi,"},{"n":4,"g":5952,"j":30,"p":591,"sj":false,"t":"'Yemyeşil-otlağı' çıkardı."},{"n":5,"g":5953,"j":30,"p":591,"sj":false,"t":"Ardından onu kuru, kara bir duruma soktu."},{"n":6,"g":5954,"j":30,"p":591,"sj":false,"t":"Sana okutacağız, sen de unutmayacaksın."},{"n":7,"g":5955,"j":30,"p":591,"sj":false,"t":"Ancak Allah'ın dilediği başka. Çünkü O, açıkta olanı da bilir, saklı duranı da."},{"n":8,"g":5956,"j":30,"p":591,"sj":false,"t":"Ve seni kolay olan için başarılı kılacağız."},{"n":9,"g":5957,"j":30,"p":591,"sj":false,"t":"Şu halde, eğer 'öğüt ve hatırlatma' bir yarar sağlayacaksa, 'öğüt verip hatırlat.'"},{"n":10,"g":5958,"j":30,"p":591,"sj":false,"t":"Allah'tan ‘İçi titreyerek korkan’ öğüt alır-düşünür."},{"n":11,"g":5959,"j":30,"p":591,"sj":false,"t":"'Mutsuz-bedbaht' olan ondan kaçınır."},{"n":12,"g":5960,"j":30,"p":591,"sj":false,"t":"Ki o, en büyük ateşe yollanacaktır."},{"n":13,"g":5961,"j":30,"p":591,"sj":false,"t":"Sonra onun içinde o, ne ölür, ne yaşar."},{"n":14,"g":5962,"j":30,"p":591,"sj":false,"t":"Doğrusu, temizlenip arınan felah bulmuştur;"},{"n":15,"g":5963,"j":30,"p":591,"sj":false,"t":"Ve Rabbinin ismini zikredip namaz kılan."},{"n":16,"g":5964,"j":30,"p":592,"sj":false,"t":"Hayır siz, dünya hayatını seçip üstün tutuyorsunuz."},{"n":17,"g":5965,"j":30,"p":592,"sj":false,"t":"Ahiret ise daha hayırlı ve daha süreklidir."},{"n":18,"g":5966,"j":30,"p":592,"sj":false,"t":"Şüphesiz bu, önceki sahifelerde vardır;"},{"n":19,"g":5967,"j":30,"p":592,"sj":false,"t":"İbrahim'in ve Musa'nın sahifelerinde."}]}
