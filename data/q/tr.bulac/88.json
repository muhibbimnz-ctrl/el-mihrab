{"n":88,"a":[{"n":1,"g":5968,"j":30,"p":592,"sj":false,"t":"(Her yanı yaygın olarak kuşatacak olan) Kıyametin haberi sana geldi mi?"},{"n":2,"g":5969,"j":30,"p":592,"sj":false,"t":"O gün, öyle yüzler vardır ki, 'zillet içinde aşağılanmıştır.'"},{"n":3,"g":5970,"j":30,"p":592,"sj":false,"t":"Çalışmış, boşuna yorulmuştur."},{"n":4,"g":5971,"j":30,"p":592,"sj":false,"t":"Kızgın bir ateşe yollanırlar."},{"n":5,"g":5972,"j":30,"p":592,"sj":false,"t":"Kaynar bir kaynaktan içirilirler."},{"n":6,"g":5973,"j":30,"p":592,"sj":false,"t":"Onlar için (zehirli olan) dari' dikeninden başka bir yiyecek yoktur."},{"n":7,"g":5974,"j":30,"p":592,"sj":false,"t":"Ne doyurup-semirtir, ne açlıktan korur."},{"n":8,"g":5975,"j":30,"p":592,"sj":false,"t":"O gün, öyle yüzler de vardır ki, nimette (engin bir mutluluk içinde)dirler."},{"n":9,"g":5976,"j":30,"p":592,"sj":false,"t":"Harcadığı-çabadan dolayı hoşnuttur."},{"n":10,"g":5977,"j":30,"p":592,"sj":false,"t":"Yüksek bir cennettedir."},{"n":11,"g":5978,"j":30,"p":592,"sj":false,"t":"Orda anlamsız bir söz işitmez."},{"n":12,"g":5979,"j":30,"p":592,"sj":false,"t":"Orda 'durmaksızın akan' bir kaynak vardır."},{"n":13,"g":5980,"j":30,"p":592,"sj":false,"t":"Orda 'yükseklerde kurulmuş, tahtlar da vardır;"},{"n":14,"g":5981,"j":30,"p":592,"sj":false,"t":"Konulmuş (içecek dolu) kaplar,"},{"n":15,"g":5982,"j":30,"p":592,"sj":false,"t":"Dizi dizi yastıklar,"},{"n":16,"g":5983,"j":30,"p":592,"sj":false,"t":"Ve serilmiş yaygılar."},{"n":17,"g":5984,"j":30,"p":592,"sj":false,"t":"Bakmıyorlar mı o deveye; nasıl yaratıldı?"},{"n":18,"g":5985,"j":30,"p":592,"sj":false,"t":"Göğe, nasıl yükseltildi?"},{"n":19,"g":5986,"j":30,"p":592,"sj":false,"t":"Dağlara; nasıl oturtulup-kuruldu?"},{"n":20,"g":5987,"j":30,"p":592,"sj":false,"t":"Yere; nasıl yayılıp-döşendi?"},{"n":21,"g":5988,"j":30,"p":592,"sj":false,"t":"Artık sen, öğüt verip-hatırlat. Sen, yalnızca bir öğüt verici-bir hatırlatıcısın."},{"n":22,"g":5989,"j":30,"p":592,"sj":false,"t":"Onlara 'zor ve baskı' kullanacak değilsin."},{"n":23,"g":5990,"j":30,"p":592,"sj":false,"t":"Ancak kim yüz çevirir ve inkar ederse"},{"n":24,"g":5991,"j":30,"p":592,"sj":false,"t":"Allah, onu en büyük azap ile azaplandırır."},{"n":25,"g":5992,"j":30,"p":592,"sj":false,"t":"Şüphesiz onların dönüşleri Bizedir."},{"n":26,"g":5993,"j":30,"p":592,"sj":false,"t":"Sonra onları hesaba çekmek de elbette Bize aittir."}]}
