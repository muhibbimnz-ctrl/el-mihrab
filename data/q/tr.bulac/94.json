{"n":94,"a":[{"n":1,"g":6091,"j":30,"p":596,"sj":false,"t":"Biz, senin göğsünü yarıp-genişletmedik mi?"},{"n":2,"g":6092,"j":30,"p":596,"sj":false,"t":"Ve yükünü indirip-atmadık mı?"},{"n":3,"g":6093,"j":30,"p":596,"sj":false,"t":"Ki o, senin belini bükmüştü;"},{"n":4,"g":6094,"j":30,"p":596,"sj":false,"t":"Senin zikrini (şanını) yüceltmedik mi?"},{"n":5,"g":6095,"j":30,"p":596,"sj":false,"t":"Demek ki, gerçekten zorlukla beraber kolaylık vardır."},{"n":6,"g":6096,"j":30,"p":596,"sj":false,"t":"Gerçekten güçlükle beraber kolaylık vardır."},{"n":7,"g":6097,"j":30,"p":596,"sj":false,"t":"Şu halde boş kaldığın zaman, durmaksızın (dua ve ibadetle) yorulmaya-devam et."},{"n":8,"g":6098,"j":30,"p":596,"sj":false,"t":"Ve yalnızca Rabbine rağbet et."}]}
