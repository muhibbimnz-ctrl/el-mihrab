{"n":95,"a":[{"n":1,"g":6099,"j":30,"p":597,"sj":false,"t":"İncire ve zeytine andolsun,"},{"n":2,"g":6100,"j":30,"p":597,"sj":false,"t":"Sina dağına,"},{"n":3,"g":6101,"j":30,"p":597,"sj":false,"t":"Ve şu emin beldeye (güvenilir şehre)."},{"n":4,"g":6102,"j":30,"p":597,"sj":false,"t":"Doğrusu, Biz insanı en güzel bir biçimde yarattık."},{"n":5,"g":6103,"j":30,"p":597,"sj":false,"t":"Sonra aşağıların aşağısına çevirdik."},{"n":6,"g":6104,"j":30,"p":597,"sj":false,"t":"Ancak iman edip salih amellerde bulunanlar başka; onlar için kesintisi olmayan bir ecir vardır."},{"n":7,"g":6105,"j":30,"p":597,"sj":false,"t":"Öyleyse bundan sonra, hangi şey sana dini yalanlatabilir?"},{"n":8,"g":6106,"j":30,"p":597,"sj":false,"t":"Allah hükmedenlerin hakimi değil midir?"}]}
