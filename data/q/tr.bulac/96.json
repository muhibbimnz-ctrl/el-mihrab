{"n":96,"a":[{"n":1,"g":6107,"j":30,"p":597,"sj":false,"t":"Yaratan Rabbin adıyla oku."},{"n":2,"g":6108,"j":30,"p":597,"sj":false,"t":"O, insanı bir alak'tan yarattı."},{"n":3,"g":6109,"j":30,"p":597,"sj":false,"t":"Oku, Rabbin en büyük kerem sahibidir;"},{"n":4,"g":6110,"j":30,"p":597,"sj":false,"t":"Ki O, kalemle (yazmayı) öğretendir."},{"n":5,"g":6111,"j":30,"p":597,"sj":false,"t":"İnsana bilmediğini öğretti."},{"n":6,"g":6112,"j":30,"p":597,"sj":false,"t":"Hayır; gerçekten insan, azar."},{"n":7,"g":6113,"j":30,"p":597,"sj":false,"t":"Kendini müstağni gördüğünden."},{"n":8,"g":6114,"j":30,"p":597,"sj":false,"t":"Şüphesiz, dönüş yalnızca Rabbinedir."},{"n":9,"g":6115,"j":30,"p":597,"sj":false,"t":"Engellemekte olanı gördün mü?"},{"n":10,"g":6116,"j":30,"p":597,"sj":false,"t":"Namaz kıldığı zaman bir kulu."},{"n":11,"g":6117,"j":30,"p":597,"sj":false,"t":"Gördün mü? Ya o (kul) doğru yol üzerinde ise,"},{"n":12,"g":6118,"j":30,"p":597,"sj":false,"t":"Ya da takvayı emrettiyse."},{"n":13,"g":6119,"j":30,"p":597,"sj":false,"t":"Gördün mü? Ya (bu engellemek isteyen) yalanlıyor ve yüz çeviriyor ise."},{"n":14,"g":6120,"j":30,"p":597,"sj":false,"t":"O, Allah'ın gördüğünü bilmiyor mu?"},{"n":15,"g":6121,"j":30,"p":597,"sj":false,"t":"Hayır; eğer o, (bu tutumuna) bir son vermeyecek olursa, andolsun, onu perçeminden tutup sürükleyeceğiz;"},{"n":16,"g":6122,"j":30,"p":597,"sj":false,"t":"O yalancı, günahkar olan alnından."},{"n":17,"g":6123,"j":30,"p":597,"sj":false,"t":"O zaman da meclisini (yakın çevresini ve yandaşlarını) çağırsın."},{"n":18,"g":6124,"j":30,"p":597,"sj":false,"t":"Biz de zebanileri çağıracağız."},{"n":19,"g":6125,"j":30,"p":597,"sj":true,"t":"Hayır; ona boyun eğme (Rabbine) Secde et ve yakınlaş."}]}
