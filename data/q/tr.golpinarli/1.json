{"n":1,"a":[{"n":1,"g":1,"j":1,"p":1,"sj":false,"t":"Rahman ve rahim Allah adiyle"},{"n":2,"g":2,"j":1,"p":1,"sj":false,"t":"Hamd, alemlerin rabbi Allah'a:"},{"n":3,"g":3,"j":1,"p":1,"sj":false,"t":"Rahmandır, rahimdir,"},{"n":4,"g":4,"j":1,"p":1,"sj":false,"t":"din gününün sahibidir."},{"n":5,"g":5,"j":1,"p":1,"sj":false,"t":"Ancak sana ibadet ederiz ve ancak senden yardım dileriz."},{"n":6,"g":6,"j":1,"p":1,"sj":false,"t":"Bize doğru yolu göster,"},{"n":7,"g":7,"j":1,"p":1,"sj":false,"t":"nimetlendirdiğin kişilerin yolunu; gazebe uğramışların da değil, sapıkların da"}]}
