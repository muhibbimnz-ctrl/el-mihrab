{"n":114,"a":[{"n":1,"g":6231,"j":30,"p":604,"sj":false,"t":"De ki: Sığınırım insanların Rabbine."},{"n":2,"g":6232,"j":30,"p":604,"sj":false,"t":"İnsanların sahibine."},{"n":3,"g":6233,"j":30,"p":604,"sj":false,"t":"İnsanların mabuduna."},{"n":4,"g":6234,"j":30,"p":604,"sj":false,"t":"Gizlice, sinsisinsi vesveseler verenin şerrinden."},{"n":5,"g":6235,"j":30,"p":604,"sj":false,"t":"Öylesine ki insanların gönüllerine vesveseler sokar."},{"n":6,"g":6236,"j":30,"p":604,"sj":false,"t":"Cinden olsun, insandan olsun, bu çeşit kişilerin şerrinden."}]}
