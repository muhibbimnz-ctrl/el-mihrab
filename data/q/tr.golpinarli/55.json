{"n":55,"a":[{"n":1,"g":4902,"j":27,"p":531,"sj":false,"t":"Rahman."},{"n":2,"g":4903,"j":27,"p":531,"sj":false,"t":"Kur'an'ı öğretti."},{"n":3,"g":4904,"j":27,"p":531,"sj":false,"t":"insanı halketti,"},{"n":4,"g":4905,"j":27,"p":531,"sj":false,"t":"ona dilleri, konuşmayı belletti."},{"n":5,"g":4906,"j":27,"p":531,"sj":false,"t":"Güneş ve ay, hesapla hareket eyler."},{"n":6,"g":4907,"j":27,"p":531,"sj":false,"t":"Ve gövdesiz bitki ve gövdeli ağaç secde eder."},{"n":7,"g":4908,"j":27,"p":531,"sj":false,"t":"Ve göğü yüceltti ve ölçüyü koydu."},{"n":8,"g":4909,"j":27,"p":531,"sj":false,"t":"Ölçüde, tartıda insafsızlık etmeyin."},{"n":9,"g":4910,"j":27,"p":531,"sj":false,"t":"Teraziyi doğru tutun, adaletle tartın ve eksik tartmayın."},{"n":10,"g":4911,"j":27,"p":531,"sj":false,"t":"Yeryüzünü alçalttı halka."},{"n":11,"g":4912,"j":27,"p":531,"sj":false,"t":"Orada meyveler ve lifli, kabuklu hurmalar var."},{"n":12,"g":4913,"j":27,"p":531,"sj":false,"t":"Yapraklı taneler var ve güzel kokulu otlar."},{"n":13,"g":4914,"j":27,"p":531,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":14,"g":4915,"j":27,"p":531,"sj":false,"t":"İyice pişmiş gibi kupkuru balçıktan, insanı halketti."},{"n":15,"g":4916,"j":27,"p":531,"sj":false,"t":"Ve cinleri, coşup kaynayan ateşten yarattı."},{"n":16,"g":4917,"j":27,"p":531,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlıyabilirsiniz?"},{"n":17,"g":4918,"j":27,"p":532,"sj":false,"t":"Rabbidir iki doğunun ve Rabbidir iki batının."},{"n":18,"g":4919,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":19,"g":4920,"j":27,"p":532,"sj":false,"t":"İki denizi salmıştır, nerdeyse karışacaklar."},{"n":20,"g":4921,"j":27,"p":532,"sj":false,"t":"Fakat aralarında bir berzah var, birbirlerine karışmazlar."},{"n":21,"g":4922,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlıyabilirsiniz?"},{"n":22,"g":4923,"j":27,"p":532,"sj":false,"t":"Her ikisinden de inci ve mercan çıkar."},{"n":23,"g":4924,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":24,"g":4925,"j":27,"p":532,"sj":false,"t":"Ve onundur denizde akıp giden dağlar gibi gemiler."},{"n":25,"g":4926,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":26,"g":4927,"j":27,"p":532,"sj":false,"t":"Yerin üstünde ne varsa fanidir."},{"n":27,"g":4928,"j":27,"p":532,"sj":false,"t":"Ve ancak ululuk ve kerem ıssı Rabbinin zatıdır kalan."},{"n":28,"g":4929,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":29,"g":4930,"j":27,"p":532,"sj":false,"t":"Ondan ister kim varsa göklerde ve yeryüzünde; o, her gün bir iştedir."},{"n":30,"g":4931,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":31,"g":4932,"j":27,"p":532,"sj":false,"t":"Ey iki ağır topluluk, insanlar ve cinler, yakında hesabınıza bakacağız."},{"n":32,"g":4933,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":33,"g":4934,"j":27,"p":532,"sj":false,"t":"Ey cin ve insan topluluğu, ölümden kurtulmak için, göklerin ve yer yüzünün bucaklarından geçip kaçmaya gücünüz yeterse geçin, kaçın; fakat geçemezsiniz bir kudret olmadıkça."},{"n":34,"g":4935,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":35,"g":4936,"j":27,"p":532,"sj":false,"t":"Üstünüze bir ateş yalımı ve erimiş bakır gönderilir de kaçamazsınız."},{"n":36,"g":4937,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":37,"g":4938,"j":27,"p":532,"sj":false,"t":"Derken gök yarılıp kırmızı bir gül rengine gelerek yağ gibi eriyince..."},{"n":38,"g":4939,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":39,"g":4940,"j":27,"p":532,"sj":false,"t":"Ne insan, ne cin, artık o gün suçlu mudur, sorulmaz."},{"n":40,"g":4941,"j":27,"p":532,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":41,"g":4942,"j":27,"p":533,"sj":false,"t":"Suçlular, yüzlerindeki alametten tanınırlar da perçemlerinden ve ayaklarından tutulurlar."},{"n":42,"g":4943,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":43,"g":4944,"j":27,"p":533,"sj":false,"t":"İşte bu, suçluların yalanladıkları cehennem."},{"n":44,"g":4945,"j":27,"p":533,"sj":false,"t":"Cehennemle içecekleri kaynar suyun arasında dolanıp dururlar."},{"n":45,"g":4946,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":46,"g":4947,"j":27,"p":533,"sj":false,"t":"Rabbinin tapısına varmaktan korkana iki cennet var."},{"n":47,"g":4948,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":48,"g":4949,"j":27,"p":533,"sj":false,"t":"İkisinde de türlütürlü nimetler var, çeşitçeşit ağaçlar."},{"n":49,"g":4950,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":50,"g":4951,"j":27,"p":533,"sj":false,"t":"İkisinde de iki ırmak var, akar."},{"n":51,"g":4952,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":52,"g":4953,"j":27,"p":533,"sj":false,"t":"İkisinde de her çeşit meyve, çifterçifter var."},{"n":53,"g":4954,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":54,"g":4955,"j":27,"p":533,"sj":false,"t":"Öylesine döşemelere yaslanacaklar ki astarları kalın ipekten, her iki cennetin, devşirilip toplanacak meyveleri de ellerinin altında, pek yakın."},{"n":55,"g":4956,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":56,"g":4957,"j":27,"p":533,"sj":false,"t":"O cennetlerde, gözlerini, eşlerinden ayırmayan ve eşlerinden önce ne bir insan tarafından dokunulmuş, ne bir cin tarafından dokunulmuş eşler var."},{"n":57,"g":4958,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":58,"g":4959,"j":27,"p":533,"sj":false,"t":"O eşler, sanki yakut ve mercan."},{"n":59,"g":4960,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":60,"g":4961,"j":27,"p":533,"sj":false,"t":"İyiliğin karşılığı, iyilikten başka bir şey olabilir mi?"},{"n":61,"g":4962,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":62,"g":4963,"j":27,"p":533,"sj":false,"t":"Bu iki cennetten başka iki cennet daha var."},{"n":63,"g":4964,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":64,"g":4965,"j":27,"p":533,"sj":false,"t":"İkisi de koyu yeşil."},{"n":65,"g":4966,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":66,"g":4967,"j":27,"p":533,"sj":false,"t":"İkisinde de iki pınar var, fışkırıp çıkar da akar."},{"n":67,"g":4968,"j":27,"p":533,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":68,"g":4969,"j":27,"p":534,"sj":false,"t":"Her ikisinde de meyveler ve hurma ve nar var."},{"n":69,"g":4970,"j":27,"p":534,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":70,"g":4971,"j":27,"p":534,"sj":false,"t":"O cennetlerde güzel huylu güzeller var."},{"n":71,"g":4972,"j":27,"p":534,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":72,"g":4973,"j":27,"p":534,"sj":false,"t":"Beyaz tenli, kara gözlü, otağlarda huriler."},{"n":73,"g":4974,"j":27,"p":534,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":74,"g":4975,"j":27,"p":534,"sj":false,"t":"Eşlerinden önce ne bir insan dokunmuş onlara, ne bir cin."},{"n":75,"g":4976,"j":27,"p":534,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":76,"g":4977,"j":27,"p":534,"sj":false,"t":"Yeşil ipeklilerle düşenmiş sedirlere ve güzelim döşemelere yaslanırlar."},{"n":77,"g":4978,"j":27,"p":534,"sj":false,"t":"Artık Rabbinizin nimetlerinden hangisini yalanlayabilirsiniz?"},{"n":78,"g":4979,"j":27,"p":534,"sj":false,"t":"Ululuk ve kerem ıssı Rabbinin adının şanı, pek yücedir."}]}
