{"n":77,"a":[{"n":1,"g":5623,"j":29,"p":580,"sj":false,"t":"Andolsun, ardı ardınca, iyilikle gönderilenlere."},{"n":2,"g":5624,"j":29,"p":580,"sj":false,"t":"Şiddetle esip yelenlere."},{"n":3,"g":5625,"j":29,"p":580,"sj":false,"t":"Bulutları yayıp sürenlere."},{"n":4,"g":5626,"j":29,"p":580,"sj":false,"t":"Gerçekle aslı olmayanı ayırt edenlere."},{"n":5,"g":5627,"j":29,"p":580,"sj":false,"t":"Öğütleri telkin edenlere."},{"n":6,"g":5628,"j":29,"p":580,"sj":false,"t":"Özürle suçu yok etmek hususunda olsun, yahut korkutma hususuna ait bulunsun."},{"n":7,"g":5629,"j":29,"p":580,"sj":false,"t":"Şüphe yok ki size vaat edilen, mutlaka olacak."},{"n":8,"g":5630,"j":29,"p":580,"sj":false,"t":"Yıldızların ışıkları sönünce."},{"n":9,"g":5631,"j":29,"p":580,"sj":false,"t":"Ve gök yarılınca."},{"n":10,"g":5632,"j":29,"p":580,"sj":false,"t":"Ve dağlar, yerlerinden kopup dümdüz olunca."},{"n":11,"g":5633,"j":29,"p":580,"sj":false,"t":"Ve peygamberler toplanınca."},{"n":12,"g":5634,"j":29,"p":580,"sj":false,"t":"Hangi gün için geciktirildi bunlar?"},{"n":13,"g":5635,"j":29,"p":580,"sj":false,"t":"Ayırma günü için."},{"n":14,"g":5636,"j":29,"p":580,"sj":false,"t":"Ve nedir, bilir misin ayırma günü?"},{"n":15,"g":5637,"j":29,"p":580,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":16,"g":5638,"j":29,"p":580,"sj":false,"t":"Önce gelenleri helak etmedik mi?"},{"n":17,"g":5639,"j":29,"p":580,"sj":false,"t":"Sonra da son gelenleri tutar, katarız onlara."},{"n":18,"g":5640,"j":29,"p":580,"sj":false,"t":"Böyle yaparız günahkarlara."},{"n":19,"g":5641,"j":29,"p":580,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":20,"g":5642,"j":29,"p":581,"sj":false,"t":"Sizi, bayağı ve azıcık bir sudan yaratmadık mı?"},{"n":21,"g":5643,"j":29,"p":581,"sj":false,"t":"Derken onu, karar edilecek kuvvetli bir yerde tutmadık mı?"},{"n":22,"g":5644,"j":29,"p":581,"sj":false,"t":"Bilinen bir müddete dek."},{"n":23,"g":5645,"j":29,"p":581,"sj":false,"t":"Derken taktir ettik yaratılışını, ne güzel de takdir ederiz biz."},{"n":24,"g":5646,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":25,"g":5647,"j":29,"p":581,"sj":false,"t":"Yeryüzünü, bir toplantı yeri olarak halk etmedik mi?"},{"n":26,"g":5648,"j":29,"p":581,"sj":false,"t":"Dirilere ve ölülere."},{"n":27,"g":5649,"j":29,"p":581,"sj":false,"t":"Ve orada, sabit ve metin dağlar yarattık ve sizi, tatlı suyla suvardık."},{"n":28,"g":5650,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":29,"g":5651,"j":29,"p":581,"sj":false,"t":"Haydi yürüyün yalanladığınıza doğru."},{"n":30,"g":5652,"j":29,"p":581,"sj":false,"t":"Yürüyün üç kola ayrılmış gölgeye doğru."},{"n":31,"g":5653,"j":29,"p":581,"sj":false,"t":"Ne gölgelendirir sizi o, ne alevden korur."},{"n":32,"g":5654,"j":29,"p":581,"sj":false,"t":"O, köşk gibi kıvılcımlar fırlatır."},{"n":33,"g":5655,"j":29,"p":581,"sj":false,"t":"Sanki o kıvılcımlar, birer sarı erkek devedir."},{"n":34,"g":5656,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":35,"g":5657,"j":29,"p":581,"sj":false,"t":"Bu, bir gündür ki söz söyleyemezler."},{"n":36,"g":5658,"j":29,"p":581,"sj":false,"t":"Onlara izin de verilmez, özür getiremezler."},{"n":37,"g":5659,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":38,"g":5660,"j":29,"p":581,"sj":false,"t":"Budur ayırma günü, sizi de toplarız, öncekileri de."},{"n":39,"g":5661,"j":29,"p":581,"sj":false,"t":"Artık bir düzeniniz varsa düzüp koşun."},{"n":40,"g":5662,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":41,"g":5663,"j":29,"p":581,"sj":false,"t":"Şüphe yok ki çekinenler, gölgeliklerdedir ve pınar başlarında,"},{"n":42,"g":5664,"j":29,"p":581,"sj":false,"t":"arzuladıkları meyveleri bulurlar."},{"n":43,"g":5665,"j":29,"p":581,"sj":false,"t":"Yiyin ve için, afiyetler olsun yaptıklarınıza karşılık."},{"n":44,"g":5666,"j":29,"p":581,"sj":false,"t":"Şüphe yok ki böyle mükafatlandırırız iyilik edenleri."},{"n":45,"g":5667,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":46,"g":5668,"j":29,"p":581,"sj":false,"t":"Yiyin ve geçinin az bir müddet, şüphe yok ki suçlularsınız siz."},{"n":47,"g":5669,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":48,"g":5670,"j":29,"p":581,"sj":false,"t":"Rüku edin denince onlara, rüku etmezler."},{"n":49,"g":5671,"j":29,"p":581,"sj":false,"t":"Vay hallerine o gün yalanlayanların."},{"n":50,"g":5672,"j":29,"p":581,"sj":false,"t":"Bundan sonra artık hangi söze inanırlar ki?"}]}
