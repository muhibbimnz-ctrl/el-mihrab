{"n":80,"a":[{"n":1,"g":5759,"j":30,"p":585,"sj":false,"t":"Yüzünü ekşitti ve döndürdü."},{"n":2,"g":5760,"j":30,"p":585,"sj":false,"t":"Yanına kör geldi diye."},{"n":3,"g":5761,"j":30,"p":585,"sj":false,"t":"Belki o, arınacaktır, ne bilirsin?"},{"n":4,"g":5762,"j":30,"p":585,"sj":false,"t":"Yahut da öğüt alacaktır da ondan faydalanacaktır."},{"n":5,"g":5763,"j":30,"p":585,"sj":false,"t":"Fakat ihtiyacı olmayana gelince."},{"n":6,"g":5764,"j":30,"p":585,"sj":false,"t":"Artık sen onun üstüne düştükçe düşüyorsun."},{"n":7,"g":5765,"j":30,"p":585,"sj":false,"t":"O arınmazsa sana ne?"},{"n":8,"g":5766,"j":30,"p":585,"sj":false,"t":"Ve fakat sana koşup gelen."},{"n":9,"g":5767,"j":30,"p":585,"sj":false,"t":"Ve korkan kişi."},{"n":10,"g":5768,"j":30,"p":585,"sj":false,"t":"Sen ondan gaflet ediyor, ona aldırış bile etmiyorsun."},{"n":11,"g":5769,"j":30,"p":585,"sj":false,"t":"Öyle değil, şüphe yok ki Kur'an, ancak bir öğüttür."},{"n":12,"g":5770,"j":30,"p":585,"sj":false,"t":"Dileyen dinler, öğüt alır."},{"n":13,"g":5771,"j":30,"p":585,"sj":false,"t":"Büyük, şerefli sayfalardadır."},{"n":14,"g":5772,"j":30,"p":585,"sj":false,"t":"Yüceltilmiştir, arıtılmıştır."},{"n":15,"g":5773,"j":30,"p":585,"sj":false,"t":"Yazıcıların ellerinde."},{"n":16,"g":5774,"j":30,"p":585,"sj":false,"t":"Büyüklerdir, hayırlı ve itaatlilerdir."},{"n":17,"g":5775,"j":30,"p":585,"sj":false,"t":"Geberesice insan, ne de kafirdir."},{"n":18,"g":5776,"j":30,"p":585,"sj":false,"t":"Onu, neden yaratmıştır?"},{"n":19,"g":5777,"j":30,"p":585,"sj":false,"t":"Bir katre sudan; yaratmıştır onu da halden hale döndürmüştür."},{"n":20,"g":5778,"j":30,"p":585,"sj":false,"t":"Sonra ona yolu kolaylatmıştır da dünyaya getirmiştir."},{"n":21,"g":5779,"j":30,"p":585,"sj":false,"t":"Sonra öldürmüştür onu da kabre sokmuştur."},{"n":22,"g":5780,"j":30,"p":585,"sj":false,"t":"Sonra da dilerse diriltir onu."},{"n":23,"g":5781,"j":30,"p":585,"sj":false,"t":"Gerçekten de insan, onun emrini tam yerine getirmedi gitti."},{"n":24,"g":5782,"j":30,"p":585,"sj":false,"t":"Artık insan, yediğine de bir baksın."},{"n":25,"g":5783,"j":30,"p":585,"sj":false,"t":"Şüphe yok ki biz, bir yağmurdur, yağdırdık."},{"n":26,"g":5784,"j":30,"p":585,"sj":false,"t":"Sonra yeryüzünü bir iyice yardık."},{"n":27,"g":5785,"j":30,"p":585,"sj":false,"t":"Derken orada tohumlar bitirdik."},{"n":28,"g":5786,"j":30,"p":585,"sj":false,"t":"Ve üzüm ve yoncalar."},{"n":29,"g":5787,"j":30,"p":585,"sj":false,"t":"Ve zeytin ve hurma."},{"n":30,"g":5788,"j":30,"p":585,"sj":false,"t":"Ve çeşitli büyük ağaçları bulunan bahçeler."},{"n":31,"g":5789,"j":30,"p":585,"sj":false,"t":"Ve meyveler ve otlaklar."},{"n":32,"g":5790,"j":30,"p":585,"sj":false,"t":"Sizin ve hayvanlarınızın faydası için."},{"n":33,"g":5791,"j":30,"p":585,"sj":false,"t":"Derken adeta kulakları sağır eden o bağırış gelip çattı mı."},{"n":34,"g":5792,"j":30,"p":585,"sj":false,"t":"O gün, bir gündür ki kişi kaçar kardeşinden."},{"n":35,"g":5793,"j":30,"p":585,"sj":false,"t":"Ve anasından ve babasından."},{"n":36,"g":5794,"j":30,"p":585,"sj":false,"t":"Ve eşinden ve çocuğundan."},{"n":37,"g":5795,"j":30,"p":585,"sj":false,"t":"Ve onların herbirinin bir derdi var ki başkalarına bakmaya vakti bile yok."},{"n":38,"g":5796,"j":30,"p":585,"sj":false,"t":"Nice yüzler o gün parılparıl parlar."},{"n":39,"g":5797,"j":30,"p":585,"sj":false,"t":"Güler, sevinir."},{"n":40,"g":5798,"j":30,"p":585,"sj":false,"t":"Ve nice yüzler o gün tozlarla bulanır."},{"n":41,"g":5799,"j":30,"p":585,"sj":false,"t":"Üstlerine bir karalıktır çöker."},{"n":42,"g":5800,"j":30,"p":585,"sj":false,"t":"İşte onlardır kafirler, suçlular."}]}
