{"n":81,"a":[{"n":1,"g":5801,"j":30,"p":586,"sj":false,"t":"Güneş dürülünce."},{"n":2,"g":5802,"j":30,"p":586,"sj":false,"t":"Ve yıldızlar kararınca."},{"n":3,"g":5803,"j":30,"p":586,"sj":false,"t":"Ve dağlar yürütülünce."},{"n":4,"g":5804,"j":30,"p":586,"sj":false,"t":"Ve dişi develer bile başı boş bırakılınca."},{"n":5,"g":5805,"j":30,"p":586,"sj":false,"t":"Ve vahşi hayvanlar bile bir araya toplanınca."},{"n":6,"g":5806,"j":30,"p":586,"sj":false,"t":"Ve denizler, coşup kabarınca."},{"n":7,"g":5807,"j":30,"p":586,"sj":false,"t":"Ve insanlar, haldeşleriyle birleşince."},{"n":8,"g":5808,"j":30,"p":586,"sj":false,"t":"Diridiri gömülen kıza sorulunca."},{"n":9,"g":5809,"j":30,"p":586,"sj":false,"t":"Hangi suç yüzünden öldürüldün diye."},{"n":10,"g":5810,"j":30,"p":586,"sj":false,"t":"Ve sahifeler dağılınca."},{"n":11,"g":5811,"j":30,"p":586,"sj":false,"t":"Ve göğün perdesi kaldırılınca."},{"n":12,"g":5812,"j":30,"p":586,"sj":false,"t":"Ve cehennem alevlendirilince."},{"n":13,"g":5813,"j":30,"p":586,"sj":false,"t":"Ve cennet yaklaştırılınca."},{"n":14,"g":5814,"j":30,"p":586,"sj":false,"t":"Herkes bilir ne hazırladığını."},{"n":15,"g":5815,"j":30,"p":586,"sj":false,"t":"Artık andolsun dönüp kaybolan."},{"n":16,"g":5816,"j":30,"p":586,"sj":false,"t":"Doğup yürüyen ve burçlarına giren yıldızlara."},{"n":17,"g":5817,"j":30,"p":586,"sj":false,"t":"Ve geçmeye başladığı çağda, geceye."},{"n":18,"g":5818,"j":30,"p":586,"sj":false,"t":"Ve ışıdığı çağda, sabaha."},{"n":19,"g":5819,"j":30,"p":586,"sj":false,"t":"Şüphe yok ki Kur'an, büyük bir elçinin sözüdür."},{"n":20,"g":5820,"j":30,"p":586,"sj":false,"t":"Kuvvetlidir, arş sahibinin katında kadri yüce."},{"n":21,"g":5821,"j":30,"p":586,"sj":false,"t":"İtaat edilir, emniyetlidir de."},{"n":22,"g":5822,"j":30,"p":586,"sj":false,"t":"Sizinle konuşan, deli değildir."},{"n":23,"g":5823,"j":30,"p":586,"sj":false,"t":"Ve andolsun, onu, apaydın tanyerinde gördü."},{"n":24,"g":5824,"j":30,"p":586,"sj":false,"t":"Arkadaşınız, gizli şeyler hakkında da nekes değildir."},{"n":25,"g":5825,"j":30,"p":586,"sj":false,"t":"Ve Kur'an, taşlanmış Şeytan'ın sözü de değildir."},{"n":26,"g":5826,"j":30,"p":586,"sj":false,"t":"Artık nereye gidiyorsunuz öyleyse?"},{"n":27,"g":5827,"j":30,"p":586,"sj":false,"t":"O, bütün alemlere bir öğüttür ancak."},{"n":28,"g":5828,"j":30,"p":586,"sj":false,"t":"Ve hele içinizden doğru hareket etmek isteyene."},{"n":29,"g":5829,"j":30,"p":586,"sj":false,"t":"Ve isteyemezsiniz, alemlerin Rabbi Allah istemedikçe."}]}
