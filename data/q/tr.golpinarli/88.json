{"n":88,"a":[{"n":1,"g":5968,"j":30,"p":592,"sj":false,"t":"Geldi mi sana her yanı ve herkesi kavrayıp kaplayan o felaketin haberi?"},{"n":2,"g":5969,"j":30,"p":592,"sj":false,"t":"O gün yüzler eğilirler."},{"n":3,"g":5970,"j":30,"p":592,"sj":false,"t":"Çalışıp çabalarlar, zahmete girip yorulurlar."},{"n":4,"g":5971,"j":30,"p":592,"sj":false,"t":"Pek kızgın ateşe atılırlar."},{"n":5,"g":5972,"j":30,"p":592,"sj":false,"t":"Pek ıssı bir suyla suvarılırlar."},{"n":6,"g":5973,"j":30,"p":592,"sj":false,"t":"Onlara orada yemek olarak ancak zehirli diken var,"},{"n":7,"g":5974,"j":30,"p":592,"sj":false,"t":"Ne besler ve ne doyurur, açlığı defeder."},{"n":8,"g":5975,"j":30,"p":592,"sj":false,"t":"O gün yüzler, sevinçlidir, neşeye dalar."},{"n":9,"g":5976,"j":30,"p":592,"sj":false,"t":"Çalıştıklarından hoşnut olurlar."},{"n":10,"g":5977,"j":30,"p":592,"sj":false,"t":"Yüce cennettedirler."},{"n":11,"g":5978,"j":30,"p":592,"sj":false,"t":"Orada boş söz duymazlar."},{"n":12,"g":5979,"j":30,"p":592,"sj":false,"t":"Orada akan bir pınar var."},{"n":13,"g":5980,"j":30,"p":592,"sj":false,"t":"Orada yükseltilmiş tahtlar."},{"n":14,"g":5981,"j":30,"p":592,"sj":false,"t":"Ve konmuş sağraklar."},{"n":15,"g":5982,"j":30,"p":592,"sj":false,"t":"Ve sırasıra konmuş yastıklar."},{"n":16,"g":5983,"j":30,"p":592,"sj":false,"t":"Yeryer yayılmış döşemeler."},{"n":17,"g":5984,"j":30,"p":592,"sj":false,"t":"Hala mı bakmazlar deveye, nasıl da yaratılmış?"},{"n":18,"g":5985,"j":30,"p":592,"sj":false,"t":"Ve göğe, nasıl da yüceltilmiş?"},{"n":19,"g":5986,"j":30,"p":592,"sj":false,"t":"Ve dağlara, nasıl da dikilmiş."},{"n":20,"g":5987,"j":30,"p":592,"sj":false,"t":"Ve yeryüzüne, nasıl da yayılmış?"},{"n":21,"g":5988,"j":30,"p":592,"sj":false,"t":"Artık korkut, öğüt ver, sen, ancak bir korkutucusun, bir öğütçü."},{"n":22,"g":5989,"j":30,"p":592,"sj":false,"t":"Onlara musallat olmuş biri değilsin."},{"n":23,"g":5990,"j":30,"p":592,"sj":false,"t":"Ancak kabul etmeyen ve kafir olana gelince."},{"n":24,"g":5991,"j":30,"p":592,"sj":false,"t":"Artık onu Allah azaplandırır pek büyük bir azapla."},{"n":25,"g":5992,"j":30,"p":592,"sj":false,"t":"Şüphe yok ki tapımızdır gelecekleri yer."},{"n":26,"g":5993,"j":30,"p":592,"sj":false,"t":"Sonra da şüphe yok ki hesaplarını görmek, bize düşer."}]}
