{"n":90,"a":[{"n":1,"g":6024,"j":30,"p":594,"sj":false,"t":"Andolsun bu şehre."},{"n":2,"g":6025,"j":30,"p":594,"sj":false,"t":"Ki sen oturmadasın bu şehirde."},{"n":3,"g":6026,"j":30,"p":594,"sj":false,"t":"Ve babaya ve oğula."},{"n":4,"g":6027,"j":30,"p":594,"sj":false,"t":"Gerçekten de biz insanı sıkıntı içinde yarattık."},{"n":5,"g":6028,"j":30,"p":594,"sj":false,"t":"Hiçbir kimsenin, ona gücü yetmez mi sanır?"},{"n":6,"g":6029,"j":30,"p":594,"sj":false,"t":"Ben, birçok mal helak ettim der."},{"n":7,"g":6030,"j":30,"p":594,"sj":false,"t":"Hiçbir kimse, onu görmez mi sanır?"},{"n":8,"g":6031,"j":30,"p":594,"sj":false,"t":"Onun için halketmedik mi iki göz."},{"n":9,"g":6032,"j":30,"p":594,"sj":false,"t":"Ve bir dille iki dudak?"},{"n":10,"g":6033,"j":30,"p":594,"sj":false,"t":"Ve ona iki sarp yol gösterdik."},{"n":11,"g":6034,"j":30,"p":594,"sj":false,"t":"Derken dayanmadı o yokuşa."},{"n":12,"g":6035,"j":30,"p":594,"sj":false,"t":"Ve bilir misin, yokuş nedir?"},{"n":13,"g":6036,"j":30,"p":594,"sj":false,"t":"Bir kul azat etmek."},{"n":14,"g":6037,"j":30,"p":594,"sj":false,"t":"Yahut açlık, kıtlık gününde doyurmak."},{"n":15,"g":6038,"j":30,"p":594,"sj":false,"t":"Yakınlığı olan bir yetimi."},{"n":16,"g":6039,"j":30,"p":594,"sj":false,"t":"Yahut yerlere döşenmiş bir yoksulu."},{"n":17,"g":6040,"j":30,"p":594,"sj":false,"t":"Sonra da inananlardan ve birbirlerine sabrı tavsiye edenlerden ve acımayı tavsiye edenlerden olmak."},{"n":18,"g":6041,"j":30,"p":594,"sj":false,"t":"Onlardır işte sağ taraf ehli."},{"n":19,"g":6042,"j":30,"p":594,"sj":false,"t":"Delillerimize kafir olanlara gelince: Onlardır sol taraf ehli."},{"n":20,"g":6043,"j":30,"p":594,"sj":false,"t":"Onlaradır kapıları, üstlerine örtülmüş ateş."}]}
