{"n":94,"a":[{"n":1,"g":6091,"j":30,"p":596,"sj":false,"t":"Senin göğsünü açıp genişletmedik mi?"},{"n":2,"g":6092,"j":30,"p":596,"sj":false,"t":"Ve senin yükünü kaldırıp attık."},{"n":3,"g":6093,"j":30,"p":596,"sj":false,"t":"Öylesine yük ki çökertmişti belini."},{"n":4,"g":6094,"j":30,"p":596,"sj":false,"t":"Ve adını yücelttik."},{"n":5,"g":6095,"j":30,"p":596,"sj":false,"t":"Artık şüphe yok ki her güçlükle beraber bir de kolaylık var."},{"n":6,"g":6096,"j":30,"p":596,"sj":false,"t":"Şüphe yok ki her güçlükle beraber bir de kolaylık var."},{"n":7,"g":6097,"j":30,"p":596,"sj":false,"t":"Artık sen de ibadeti bitirince yorul."},{"n":8,"g":6098,"j":30,"p":596,"sj":false,"t":"Ve ancak Rabbinden iste, ona doğrul."}]}
