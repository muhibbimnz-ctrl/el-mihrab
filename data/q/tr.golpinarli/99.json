{"n":99,"a":[{"n":1,"g":6139,"j":30,"p":599,"sj":false,"t":"Yeryüzü, şiddetli bir depremle sarsılınca."},{"n":2,"g":6140,"j":30,"p":599,"sj":false,"t":"Ve yeryüzü, ağırlıklarını çıkarınca."},{"n":3,"g":6141,"j":30,"p":599,"sj":false,"t":"Ve insan, ne oluyor ki buna deyince."},{"n":4,"g":6142,"j":30,"p":599,"sj":false,"t":"O gün, bütün haberlerini anlatınca."},{"n":5,"g":6143,"j":30,"p":599,"sj":false,"t":"Çünkü Rabbin, vahyetmiştir, bildirmiştir ona."},{"n":6,"g":6144,"j":30,"p":599,"sj":false,"t":"O gün insanlar, gittikleri yerden gelirler, yaptıklarını görmek için."},{"n":7,"g":6145,"j":30,"p":599,"sj":false,"t":"Artık kim, bir zerre ağırlığı hayır yapmışsa görür onu."},{"n":8,"g":6146,"j":30,"p":599,"sj":false,"t":"Ve kim, bir zerre ağırlığı şer yapmışsa görür onu."}]}
