{"n":100,"a":[{"n":1,"g":6147,"j":30,"p":599,"sj":false,"t":"O harıl harıl (savaşa) koşanlara,"},{"n":2,"g":6148,"j":30,"p":599,"sj":false,"t":"(Tırnaklarıyla yerden) ateş çıkaranlara,"},{"n":3,"g":6149,"j":30,"p":599,"sj":false,"t":"Sabahleyin akın edenlere,"},{"n":4,"g":6150,"j":30,"p":599,"sj":false,"t":"Tozu dumana karıştıranlara,"},{"n":5,"g":6151,"j":30,"p":599,"sj":false,"t":"Derken bir topluluğun ortasına dalanlara yemin ederim ki,"},{"n":6,"g":6152,"j":30,"p":599,"sj":false,"t":"Şüphesiz insan, Rabbine karşı çok nankördür."},{"n":7,"g":6153,"j":30,"p":599,"sj":false,"t":"Ve kendisi de buna şahittir."},{"n":8,"g":6154,"j":30,"p":599,"sj":false,"t":"Gerçekten o dünya malını çok sevdiği için katıdır."},{"n":9,"g":6155,"j":30,"p":599,"sj":false,"t":"Bilmiyor mu ki, kabirlerin içindekiler fırlatılacak."},{"n":10,"g":6156,"j":30,"p":600,"sj":false,"t":"Ve sinelerin içindekiler derlenecek."},{"n":11,"g":6157,"j":30,"p":600,"sj":false,"t":"O gün Rableri onların bütün yaptıklarından haberdardır"}]}
