{"n":105,"a":[{"n":1,"g":6189,"j":30,"p":601,"sj":false,"t":"Görmedin mi Rabb'in fil sahiplerine ne yaptı?"},{"n":2,"g":6190,"j":30,"p":601,"sj":false,"t":"Onların tuzaklarını boşa çıkarmadı mı?"},{"n":3,"g":6191,"j":30,"p":601,"sj":false,"t":"Üzerlerine sürü sürü kuşlar gönderdi."},{"n":4,"g":6192,"j":30,"p":601,"sj":false,"t":"Onlara çamurdan sertleşmiş taşlar atıyorlardı."},{"n":5,"g":6193,"j":30,"p":601,"sj":false,"t":"Ve onları, yenilmiş ekin yaprağı gibi yaptı."}]}
