{"n":55,"a":[{"n":1,"g":4902,"j":27,"p":531,"sj":false,"t":"Rahmân (çok merhametli olan Allah)"},{"n":2,"g":4903,"j":27,"p":531,"sj":false,"t":"Kurân'ı öğretti."},{"n":3,"g":4904,"j":27,"p":531,"sj":false,"t":"İnsanı yarattı."},{"n":4,"g":4905,"j":27,"p":531,"sj":false,"t":"Ona beyanı öğretti."},{"n":5,"g":4906,"j":27,"p":531,"sj":false,"t":"Güneş de ay da bir hesab iledir."},{"n":6,"g":4907,"j":27,"p":531,"sj":false,"t":"Bitkiler ve ağaçlar secde etmektedirler."},{"n":7,"g":4908,"j":27,"p":531,"sj":false,"t":"Göğü yükseltti ve mizanı koydu."},{"n":8,"g":4909,"j":27,"p":531,"sj":false,"t":"Sakın tartıda taşkınlık etmeyin."},{"n":9,"g":4910,"j":27,"p":531,"sj":false,"t":"Tartıyı adaletle yapın, terazide eksiklik yapmayın."},{"n":10,"g":4911,"j":27,"p":531,"sj":false,"t":"(Allah) yeri mahlukat için (aşağıya) koydu."},{"n":11,"g":4912,"j":27,"p":531,"sj":false,"t":"Orada meyvalar ve salkımlı hurma ağaçları vardır."},{"n":12,"g":4913,"j":27,"p":531,"sj":false,"t":"Yapraklı taneler ve hoş kokulu bitkiler vardır."},{"n":13,"g":4914,"j":27,"p":531,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":14,"g":4915,"j":27,"p":531,"sj":false,"t":"Allah insanı, pişmiş bir çamura benzeyen bir balçıktan yarattı."},{"n":15,"g":4916,"j":27,"p":531,"sj":false,"t":"Cinleri de hâlis ateşten yarattı."},{"n":16,"g":4917,"j":27,"p":531,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":17,"g":4918,"j":27,"p":532,"sj":false,"t":"(O) iki doğunun ve iki batının Rabbidir."},{"n":18,"g":4919,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":19,"g":4920,"j":27,"p":532,"sj":false,"t":"(Acı ve tatlı) iki denizi salıverdi birbirine kavuşuyorlar."},{"n":20,"g":4921,"j":27,"p":532,"sj":false,"t":"Fakat aralarında bir engel vardır, birbirlerine geçip karışmıyorlar."},{"n":21,"g":4922,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":22,"g":4923,"j":27,"p":532,"sj":false,"t":"İkisinden de inci ve mercan çıkar."},{"n":23,"g":4924,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":24,"g":4925,"j":27,"p":532,"sj":false,"t":"Denizde koca dağlar gibi yükselen gemiler de onundur."},{"n":25,"g":4926,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":26,"g":4927,"j":27,"p":532,"sj":false,"t":"Yer üzerinde bulunan her şey fânidir."},{"n":27,"g":4928,"j":27,"p":532,"sj":false,"t":"Yalnız celâl ve ikram sahibi Rabbinin yüzü (zâtı) baki kalacaktır."},{"n":28,"g":4929,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":29,"g":4930,"j":27,"p":532,"sj":false,"t":"Göklerde ve yerde bulunanlar, O'ndan isterler. O, her gün yeni bir iştedir."},{"n":30,"g":4931,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":31,"g":4932,"j":27,"p":532,"sj":false,"t":"Ey insan ve cin! sizin de hesabınızı ele alacağız."},{"n":32,"g":4933,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":33,"g":4934,"j":27,"p":532,"sj":false,"t":"Ey cin ve insan toplulukları! Göklerin ve yerin çevresinden geçmeye gücünüz yeterse geçin gidin. Allah'ın verdiği bir güç olmadan geçemezsiniz."},{"n":34,"g":4935,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":35,"g":4936,"j":27,"p":532,"sj":false,"t":"Üzerinize ateşten alev ve duman gönderilir, kendinizi savunamazsınız."},{"n":36,"g":4937,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz"},{"n":37,"g":4938,"j":27,"p":532,"sj":false,"t":"Gök yarılıp da, erimiş yağ gibi kıpkırmızı bir gül olduğu zaman..."},{"n":38,"g":4939,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":39,"g":4940,"j":27,"p":532,"sj":false,"t":"İşte o gün, ne insana ne de cinne günahından sorulmaz."},{"n":40,"g":4941,"j":27,"p":532,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":41,"g":4942,"j":27,"p":533,"sj":false,"t":"Suçlular simalarından tanınır, alınlarından ve ayaklarından tutulur."},{"n":42,"g":4943,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":43,"g":4944,"j":27,"p":533,"sj":false,"t":"İşte bu, suçluların yalanladığı cehennemdir."},{"n":44,"g":4945,"j":27,"p":533,"sj":false,"t":"Onunla kaynar su arasında dolaşırlar."},{"n":45,"g":4946,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":46,"g":4947,"j":27,"p":533,"sj":false,"t":"Rabbinin makamından korkan kimselere iki cennet vardır."},{"n":47,"g":4948,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":48,"g":4949,"j":27,"p":533,"sj":false,"t":"İkisinin de çeşitli ağaçları, meyvaları vardır."},{"n":49,"g":4950,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":50,"g":4951,"j":27,"p":533,"sj":false,"t":"İkisinde de akıp giden iki kaynak vardır."},{"n":51,"g":4952,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":52,"g":4953,"j":27,"p":533,"sj":false,"t":"İkisinde de her türlü meyvadan çift çift vardır."},{"n":53,"g":4954,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":54,"g":4955,"j":27,"p":533,"sj":false,"t":"Astarları atlastan yataklara yaslanırlar. İki cennetin de devşirmesi yakındır."},{"n":55,"g":4956,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":56,"g":4957,"j":27,"p":533,"sj":false,"t":"Oralarda gözlerini yalnız eşlerine çevirmiş dilberler var ki, bunlardan önce onlara ne insan ne de cin dokunmuştur."},{"n":57,"g":4958,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":58,"g":4959,"j":27,"p":533,"sj":false,"t":"Sanki onlar yâkut ve mercandırlar."},{"n":59,"g":4960,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":60,"g":4961,"j":27,"p":533,"sj":false,"t":"İyiliğin karşılığı, yalnız iyilik değil midir?"},{"n":61,"g":4962,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":62,"g":4963,"j":27,"p":533,"sj":false,"t":"Bu ikisinden başka iki cennet daha vardır."},{"n":63,"g":4964,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":64,"g":4965,"j":27,"p":533,"sj":false,"t":"(Bu cennetler) yemyeşildirler."},{"n":65,"g":4966,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":66,"g":4967,"j":27,"p":533,"sj":false,"t":"İkisinde de fışkıran iki kaynak vardır."},{"n":67,"g":4968,"j":27,"p":533,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":68,"g":4969,"j":27,"p":534,"sj":false,"t":"İkisinde de her türlü meyva, hurma ve nar vardır."},{"n":69,"g":4970,"j":27,"p":534,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":70,"g":4971,"j":27,"p":534,"sj":false,"t":"İçlerinde güzel huylu, güzel yüzlü kadınlar vardır."},{"n":71,"g":4972,"j":27,"p":534,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":72,"g":4973,"j":27,"p":534,"sj":false,"t":"Çadırlar içerisinde gözlerini yalnız kocalarına çevirmiş hûriler vardır."},{"n":73,"g":4974,"j":27,"p":534,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":74,"g":4975,"j":27,"p":534,"sj":false,"t":"Bunlardan önce onlara ne insan ne de cin dokunmuştur."},{"n":75,"g":4976,"j":27,"p":534,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":76,"g":4977,"j":27,"p":534,"sj":false,"t":"Yeşil yastıklara ve hârikulâde güzel işlemeli döşeklere yaslanırlar."},{"n":77,"g":4978,"j":27,"p":534,"sj":false,"t":"Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?"},{"n":78,"g":4979,"j":27,"p":534,"sj":false,"t":"Büyüklük ve ikram sahibi Rabbinin adı ne yücedir!"}]}
