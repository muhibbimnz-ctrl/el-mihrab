{"n":56,"a":[{"n":1,"g":4980,"j":27,"p":534,"sj":false,"t":"Olacak vak'a olduğu zaman"},{"n":2,"g":4981,"j":27,"p":534,"sj":false,"t":"Onun oluşunu yalanlayacak kimse yoktur."},{"n":3,"g":4982,"j":27,"p":534,"sj":false,"t":"O, alçaltıcıdır, yükselticidir."},{"n":4,"g":4983,"j":27,"p":534,"sj":false,"t":"Yer şiddetle sarsıldığı"},{"n":5,"g":4984,"j":27,"p":534,"sj":false,"t":"Dağlar serpildikçe serpildiği"},{"n":6,"g":4985,"j":27,"p":534,"sj":false,"t":"Dağılıp toz duman haline geldiği"},{"n":7,"g":4986,"j":27,"p":534,"sj":false,"t":"Ve sizler üç sınıf olduğunuz zaman"},{"n":8,"g":4987,"j":27,"p":534,"sj":false,"t":"Sağın adamları (var ya) ne mutludurlar onlar!"},{"n":9,"g":4988,"j":27,"p":534,"sj":false,"t":"Solun adamları ise ne uğursuzdurlar onlar!"},{"n":10,"g":4989,"j":27,"p":534,"sj":false,"t":"Önde olanlar (var ya), onlar öncüdürler."},{"n":11,"g":4990,"j":27,"p":534,"sj":false,"t":"İşte o yaklaştırılanlar,"},{"n":12,"g":4991,"j":27,"p":534,"sj":false,"t":"Nimet cennetlerindedirler."},{"n":13,"g":4992,"j":27,"p":534,"sj":false,"t":"Çoğu önceki ümmetlerden,"},{"n":14,"g":4993,"j":27,"p":534,"sj":false,"t":"Birazı da sonrakilerden."},{"n":15,"g":4994,"j":27,"p":534,"sj":false,"t":"(Onlar) cevherlerle işlenmiş tahtlar üzerindedirler."},{"n":16,"g":4995,"j":27,"p":534,"sj":false,"t":"Karşılıklı olarak onların üzerinde yaslanırlar."},{"n":17,"g":4996,"j":27,"p":535,"sj":false,"t":"Çevrelerinde, ölümsüzlüğe ulaşmış gençler dolaşırlar."},{"n":18,"g":4997,"j":27,"p":535,"sj":false,"t":"Kaynağından doldurulmuş, testiler, ibrikler ve kadehlerle."},{"n":19,"g":4998,"j":27,"p":535,"sj":false,"t":"Ondan ne başları ağrıtılır, ne de akılları giderilir."},{"n":20,"g":4999,"j":27,"p":535,"sj":false,"t":"Beğendikleri meyvalar,"},{"n":21,"g":5000,"j":27,"p":535,"sj":false,"t":"Canlarının çektiği kuş etleri,"},{"n":22,"g":5001,"j":27,"p":535,"sj":false,"t":"İri gözlü hûriler,"},{"n":23,"g":5002,"j":27,"p":535,"sj":false,"t":"Saklı inciler gibi,"},{"n":24,"g":5003,"j":27,"p":535,"sj":false,"t":"Yaptıklarına karşılık olarak verilir."},{"n":25,"g":5004,"j":27,"p":535,"sj":false,"t":"Orada boş bir söz ve günaha sokan bir laf işitmezler."},{"n":26,"g":5005,"j":27,"p":535,"sj":false,"t":"Duydukları söz, yalnız \"selam\", \"selam\" dır."},{"n":27,"g":5006,"j":27,"p":535,"sj":false,"t":"Sağın adamları, nedir o sağın adamları!"},{"n":28,"g":5007,"j":27,"p":535,"sj":false,"t":"Dalbastı kirazlar,"},{"n":29,"g":5008,"j":27,"p":535,"sj":false,"t":"Meyva dizili muzlar,"},{"n":30,"g":5009,"j":27,"p":535,"sj":false,"t":"Uzamış gölgeler,"},{"n":31,"g":5010,"j":27,"p":535,"sj":false,"t":"Fışkıran sular."},{"n":32,"g":5011,"j":27,"p":535,"sj":false,"t":"Pek çok meyva arasında,"},{"n":33,"g":5012,"j":27,"p":535,"sj":false,"t":"Tükenmeyen ve yasaklanmayan"},{"n":34,"g":5013,"j":27,"p":535,"sj":false,"t":"Ve yükseltilmiş döşekler üstündedirler."},{"n":35,"g":5014,"j":27,"p":535,"sj":false,"t":"Biz kadınları yeniden inşa ettik (yarattık)."},{"n":36,"g":5015,"j":27,"p":535,"sj":false,"t":"Onları bâkireler yaptık."},{"n":37,"g":5016,"j":27,"p":535,"sj":false,"t":"Hep yaşıt sevgililer,"},{"n":38,"g":5017,"j":27,"p":535,"sj":false,"t":"Sağın adamları içindir."},{"n":39,"g":5018,"j":27,"p":535,"sj":false,"t":"Bir çoğu öncekilerdendir."},{"n":40,"g":5019,"j":27,"p":535,"sj":false,"t":"Bir çoğu da sonrakilerdendir."},{"n":41,"g":5020,"j":27,"p":535,"sj":false,"t":"Solun adamları, nedir o solcular!"},{"n":42,"g":5021,"j":27,"p":535,"sj":false,"t":"İçlerine işleyen bir ateş ve kaynar şu içinde,"},{"n":43,"g":5022,"j":27,"p":535,"sj":false,"t":"Kapkara dumandan bir gölge altındadırlar."},{"n":44,"g":5023,"j":27,"p":535,"sj":false,"t":"Ki ne serindir, ne de faydalı."},{"n":45,"g":5024,"j":27,"p":535,"sj":false,"t":"Çünkü onlar bundan önce varlık içinde sefâhete dalmışlardı."},{"n":46,"g":5025,"j":27,"p":535,"sj":false,"t":"Büyük günahı işlemekte ısrar ediyorlardı."},{"n":47,"g":5026,"j":27,"p":535,"sj":false,"t":"Ve diyorlardı ki: \"Biz ölüp, toprak ve kemik yığını olduktan sonra, biz mi bir daha diriltileceğiz?\""},{"n":48,"g":5027,"j":27,"p":535,"sj":false,"t":"\"Önceki atalarımızda mı?\""},{"n":49,"g":5028,"j":27,"p":535,"sj":false,"t":"De ki: \"Öncekiler ve sonrakiler\""},{"n":50,"g":5029,"j":27,"p":535,"sj":false,"t":"\"Belli bir günün belli vaktinde mutlaka toplanacaklardır.\""},{"n":51,"g":5030,"j":27,"p":536,"sj":false,"t":"Sonra siz, ey sapık yalanlayıcılar!"},{"n":52,"g":5031,"j":27,"p":536,"sj":false,"t":"Elbette bir ağaçtan, zakkum ağacından yiyeceksiniz."},{"n":53,"g":5032,"j":27,"p":536,"sj":false,"t":"Karınlarınızı hep onunla dolduracaksınız."},{"n":54,"g":5033,"j":27,"p":536,"sj":false,"t":"Üstüne de kaynar su içeceksiniz."},{"n":55,"g":5034,"j":27,"p":536,"sj":false,"t":"Susuzluk illetine tutulmuş develerin içişi gibi içeceksiniz."},{"n":56,"g":5035,"j":27,"p":536,"sj":false,"t":"İşte ceza gününde onlara sunulacak ziyafet budur."},{"n":57,"g":5036,"j":27,"p":536,"sj":false,"t":"Biz sizi yarattık; tasdik etmeniz gerekmez mi?"},{"n":58,"g":5037,"j":27,"p":536,"sj":false,"t":"Attığınız meniyi gördünüz mü?"},{"n":59,"g":5038,"j":27,"p":536,"sj":false,"t":"Onu siz mi yaratıyorsunuz yoksa yaratan biz miyiz?"},{"n":60,"g":5039,"j":27,"p":536,"sj":false,"t":"Aranızda ölümü takdir eden biziz ve bizim önümüze geçilmez."},{"n":61,"g":5040,"j":27,"p":536,"sj":false,"t":"Böylece sizin yerinize benzerlerinizi getirelim ve sizi bilmediğiniz bir yaratılışta tekrar var edelim diye (böyle yapıyoruz)."},{"n":62,"g":5041,"j":27,"p":536,"sj":false,"t":"Andolsun, ilk yaratılışı bildiniz. Düşünüp ibret almanız gerekmez mi?"},{"n":63,"g":5042,"j":27,"p":536,"sj":false,"t":"Ektiğinizi gördünüz mü?"},{"n":64,"g":5043,"j":27,"p":536,"sj":false,"t":"Onu siz mi bitiriyorsunuz, yoksa bitiren biz miyiz?"},{"n":65,"g":5044,"j":27,"p":536,"sj":false,"t":"Dileseydik, onu kuru bir çöp yapardık. Hayret eder dururdunuz."},{"n":66,"g":5045,"j":27,"p":536,"sj":false,"t":"\"Doğrusu borç altına girdik.\""},{"n":67,"g":5046,"j":27,"p":536,"sj":false,"t":"\"Doğrusu, biz yoksul bırakıldık\" (derdiniz)."},{"n":68,"g":5047,"j":27,"p":536,"sj":false,"t":"İçtiğiniz suya baktınız mı?"},{"n":69,"g":5048,"j":27,"p":536,"sj":false,"t":"Buluttan onu siz mi indirdiniz, yoksa indiren biz miyiz?"},{"n":70,"g":5049,"j":27,"p":536,"sj":false,"t":"Dileseydik onu tuzlu yapardık. O halde şükretseniz ya!"},{"n":71,"g":5050,"j":27,"p":536,"sj":false,"t":"Yaktığınız ateşi gördünüz mü?"},{"n":72,"g":5051,"j":27,"p":536,"sj":false,"t":"Onun ağacını siz mi yarattınız, yoksa yaratan biz miyiz?"},{"n":73,"g":5052,"j":27,"p":536,"sj":false,"t":"Biz onu bir ibret ve çölden gelip geçenlere bir fayda yaptık."},{"n":74,"g":5053,"j":27,"p":536,"sj":false,"t":"Öyleyse büyük Rabbinin adını yücelt."},{"n":75,"g":5054,"j":27,"p":536,"sj":false,"t":"Hayır, yıldızların yerlerine yemin ederim."},{"n":76,"g":5055,"j":27,"p":536,"sj":false,"t":"Bilirseniz bu büyük bir yemindir."},{"n":77,"g":5056,"j":27,"p":537,"sj":false,"t":"O, elbette şerefli bir Kur'ân'dır."},{"n":78,"g":5057,"j":27,"p":537,"sj":false,"t":"Korunmuş bir kitaptadır."},{"n":79,"g":5058,"j":27,"p":537,"sj":false,"t":"Ona temizlenenlerden başkası el süremez."},{"n":80,"g":5059,"j":27,"p":537,"sj":false,"t":"(O), âlemlerin Rabbinden indirilmiştir."},{"n":81,"g":5060,"j":27,"p":537,"sj":false,"t":"Şimdi siz bu sözü mü küçümsüyorsunuz?"},{"n":82,"g":5061,"j":27,"p":537,"sj":false,"t":"Rızkınızı, yalanlamanızdan ibaret mi kılıyorsunuz?"},{"n":83,"g":5062,"j":27,"p":537,"sj":false,"t":"Can boğaza dayandığı zaman"},{"n":84,"g":5063,"j":27,"p":537,"sj":false,"t":"Ki o zaman siz (ölmek üzere olana) bakar durursunuz."},{"n":85,"g":5064,"j":27,"p":537,"sj":false,"t":"Biz ona sizden daha yakınız, fakat siz görmezsiniz."},{"n":86,"g":5065,"j":27,"p":537,"sj":false,"t":"Eğer cezalandırılmayacak iseniz,"},{"n":87,"g":5066,"j":27,"p":537,"sj":false,"t":"Onu geri çevirsenize; şayet iddianızda doğru iseniz."},{"n":88,"g":5067,"j":27,"p":537,"sj":false,"t":"Fakat ölen kişiye gelince, eğer o rahmete yaklaştırılanlardan ise,"},{"n":89,"g":5068,"j":27,"p":537,"sj":false,"t":"Ona rahatlık, güzel rızık ve Naîm cenneti vardır."},{"n":90,"g":5069,"j":27,"p":537,"sj":false,"t":"Eğer O, sağın adamlarından ise,"},{"n":91,"g":5070,"j":27,"p":537,"sj":false,"t":"\"(Ey sağcı), sana sağcılardan selam!\""},{"n":92,"g":5071,"j":27,"p":537,"sj":false,"t":"Ama yalanlayıcı sapıklardan ise;"},{"n":93,"g":5072,"j":27,"p":537,"sj":false,"t":"İşte ona da kaynar sudan bir ziyafet vardır."},{"n":94,"g":5073,"j":27,"p":537,"sj":false,"t":"Ve cehenneme atılma vardır."},{"n":95,"g":5074,"j":27,"p":537,"sj":false,"t":"Kesin gerçek budur işte."},{"n":96,"g":5075,"j":27,"p":537,"sj":false,"t":"Öyle ise Rabbini o büyük ismiyle tesbih et."}]}
