{"n":77,"a":[{"n":1,"g":5623,"j":29,"p":580,"sj":false,"t":"Andolsun birbiri ardınca gönderilenlere,"},{"n":2,"g":5624,"j":29,"p":580,"sj":false,"t":"Büküp devirenlere,"},{"n":3,"g":5625,"j":29,"p":580,"sj":false,"t":"Yaydıkça yayanlara,"},{"n":4,"g":5626,"j":29,"p":580,"sj":false,"t":"Seçip ayıranlara,"},{"n":5,"g":5627,"j":29,"p":580,"sj":false,"t":"Bir öğüt bırakanlara,"},{"n":6,"g":5628,"j":29,"p":580,"sj":false,"t":"Gerek özür için olsun, gerek uyarı için,"},{"n":7,"g":5629,"j":29,"p":580,"sj":false,"t":"Herhalde size vaad olunan kesinlikle olacaktır."},{"n":8,"g":5630,"j":29,"p":580,"sj":false,"t":"Hani o yıldızlar silindiği zaman,"},{"n":9,"g":5631,"j":29,"p":580,"sj":false,"t":"Gök yarıldığı zaman,"},{"n":10,"g":5632,"j":29,"p":580,"sj":false,"t":"Dağlar savrulduğu zaman,"},{"n":11,"g":5633,"j":29,"p":580,"sj":false,"t":"Elçiler, tayin edilen vakitlerine erdirildikleri zaman,"},{"n":12,"g":5634,"j":29,"p":580,"sj":false,"t":"Bunlar hangi güne ertelendiler?"},{"n":13,"g":5635,"j":29,"p":580,"sj":false,"t":"Hüküm gününe.."},{"n":14,"g":5636,"j":29,"p":580,"sj":false,"t":"Bildin mi, nedir o hüküm günü?"},{"n":15,"g":5637,"j":29,"p":580,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":16,"g":5638,"j":29,"p":580,"sj":false,"t":"Biz, öncekileri helak etmedik mi?"},{"n":17,"g":5639,"j":29,"p":580,"sj":false,"t":"Sonra geridekileri de onlara katarız."},{"n":18,"g":5640,"j":29,"p":580,"sj":false,"t":"Biz suçlulara böyle yaparız."},{"n":19,"g":5641,"j":29,"p":580,"sj":false,"t":"O gün yalanlayanların vah haline!"},{"n":20,"g":5642,"j":29,"p":581,"sj":false,"t":"Biz sizi âdi bir sudan yaratmadık mı?"},{"n":21,"g":5643,"j":29,"p":581,"sj":false,"t":"Onu sağlam bir yerde oturttuk."},{"n":22,"g":5644,"j":29,"p":581,"sj":false,"t":"Belli bir süreye kadar."},{"n":23,"g":5645,"j":29,"p":581,"sj":false,"t":"Demek ki biçimlendirmişiz. Ne güzel biçimlendireniz biz."},{"n":24,"g":5646,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":25,"g":5647,"j":29,"p":581,"sj":false,"t":"Yeryüzünü bir tokat (toplanma yeri) yapmadık mı?"},{"n":26,"g":5648,"j":29,"p":581,"sj":false,"t":"Gerek diriler, gerekse ölüler için."},{"n":27,"g":5649,"j":29,"p":581,"sj":false,"t":"Orada yüksek yüksek dağlar oturtup da size bir tatlı su sunmadık mı?"},{"n":28,"g":5650,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":29,"g":5651,"j":29,"p":581,"sj":false,"t":"(Kıyameti yalanlayanlara şöyle denir): \"Haydin gidin o yalanladığınız şeye doğru.\""},{"n":30,"g":5652,"j":29,"p":581,"sj":false,"t":"\"Haydi gidin o üç çatallı gölgeye (cehenneme).\""},{"n":31,"g":5653,"j":29,"p":581,"sj":false,"t":"O, ne gölgelendirir, ne alevden korur."},{"n":32,"g":5654,"j":29,"p":581,"sj":false,"t":"O, saray gibi kıvılcımlar atar."},{"n":33,"g":5655,"j":29,"p":581,"sj":false,"t":"Sanki o kıvılcımlar, sarı sarı (erkek deve sürüleridir)."},{"n":34,"g":5656,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":35,"g":5657,"j":29,"p":581,"sj":false,"t":"Bugün, konuşamıyacakları gündür."},{"n":36,"g":5658,"j":29,"p":581,"sj":false,"t":"Kendilerine izin de verilmez ki, özür beyan etsinler."},{"n":37,"g":5659,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":38,"g":5660,"j":29,"p":581,"sj":false,"t":"Bu, işte o hüküm günüdür. Sizi ve öncekileri bir araya topladık."},{"n":39,"g":5661,"j":29,"p":581,"sj":false,"t":"Bir hileniz varsa beni atlatın."},{"n":40,"g":5662,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":41,"g":5663,"j":29,"p":581,"sj":false,"t":"Kuşkusuz takva sahipleri gölgeler altında ve pınar başlarındadır."},{"n":42,"g":5664,"j":29,"p":581,"sj":false,"t":"Canlarının çektiğinden türlü meyveler arasındadırlar."},{"n":43,"g":5665,"j":29,"p":581,"sj":false,"t":"(Onlara): \"Yaptıklarınıza karşılık afiyetle yiyin, için\" (denir)."},{"n":44,"g":5666,"j":29,"p":581,"sj":false,"t":"İşte biz güzel amel işleyenleri böyle mükafatlandırırız."},{"n":45,"g":5667,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":46,"g":5668,"j":29,"p":581,"sj":false,"t":"Yiyin, zevklenin biraz, çünkü siz suçlularsınız."},{"n":47,"g":5669,"j":29,"p":581,"sj":false,"t":"O gün yalanlayanların vay haline!"},{"n":48,"g":5670,"j":29,"p":581,"sj":false,"t":"Onlara: \"Rüku edin\" denildiği zaman etmezler."},{"n":49,"g":5671,"j":29,"p":581,"sj":false,"t":"Vay haline o gün yalanlayanların!"},{"n":50,"g":5672,"j":29,"p":581,"sj":false,"t":"Artık bundan (Kur'an'dan) sonra hangi söze inanacaklar?"}]}
