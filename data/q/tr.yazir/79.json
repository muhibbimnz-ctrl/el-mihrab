{"n":79,"a":[{"n":1,"g":5713,"j":30,"p":583,"sj":false,"t":"Andolsun şiddetle çekip çıkaranlara,"},{"n":2,"g":5714,"j":30,"p":583,"sj":false,"t":"Usulcacık çekenlere,"},{"n":3,"g":5715,"j":30,"p":583,"sj":false,"t":"Yüzüp yüzüp gidenlere,"},{"n":4,"g":5716,"j":30,"p":583,"sj":false,"t":"Yarışıp geçenlere,"},{"n":5,"g":5717,"j":30,"p":583,"sj":false,"t":"Derken bir iş çevirenlere kasem olsun (ki kıyamet var)."},{"n":6,"g":5718,"j":30,"p":583,"sj":false,"t":"O gün deprem sarsar,"},{"n":7,"g":5719,"j":30,"p":583,"sj":false,"t":"Onu ikinci bir sarsıntı izler."},{"n":8,"g":5720,"j":30,"p":583,"sj":false,"t":"Yürekler vardır, o gün kaygıdan hoplar."},{"n":9,"g":5721,"j":30,"p":583,"sj":false,"t":"Gözler kalkmaz saygıdan."},{"n":10,"g":5722,"j":30,"p":583,"sj":false,"t":"Diyorlar ki: \"Biz tekrar eski halimize mi döndürülecekmişiz?"},{"n":11,"g":5723,"j":30,"p":583,"sj":false,"t":"\"Biz, çürümüş kemikler olduktan sonra ha?\""},{"n":12,"g":5724,"j":30,"p":583,"sj":false,"t":"\"Öyleyse bu çok zararlı bir dönüştür.\" dediler."},{"n":13,"g":5725,"j":30,"p":583,"sj":false,"t":"Fakat o bir tek haykırıştır."},{"n":14,"g":5726,"j":30,"p":583,"sj":false,"t":"Bir de bakarsın hepsi meydandadır."},{"n":15,"g":5727,"j":30,"p":583,"sj":false,"t":"Musa'nın haberi sana geldi mi?"},{"n":16,"g":5728,"j":30,"p":584,"sj":false,"t":"Hani Rabbi ona kutsal vaadi Tuva'da seslenmişti:"},{"n":17,"g":5729,"j":30,"p":584,"sj":false,"t":"\"Haydi, demişti, git Firavun'a, çünkü o çok azdı.\""},{"n":18,"g":5730,"j":30,"p":584,"sj":false,"t":"De ki: İster misin arınasın?"},{"n":19,"g":5731,"j":30,"p":584,"sj":false,"t":"Seni Rabbinin yoluna ileteyim de ondan korkasın."},{"n":20,"g":5732,"j":30,"p":584,"sj":false,"t":"Musa Firavun'a o büyük mucizeyi gösterdi."},{"n":21,"g":5733,"j":30,"p":584,"sj":false,"t":"Fakat Firavun yalanladı, karşı geldi."},{"n":22,"g":5734,"j":30,"p":584,"sj":false,"t":"Sonra koşarak dönüp gitti."},{"n":23,"g":5735,"j":30,"p":584,"sj":false,"t":"Derken adamlarını topladı da bağırdı:"},{"n":24,"g":5736,"j":30,"p":584,"sj":false,"t":"\"Ben sizin en yüce Rabbinizim\" dedi."},{"n":25,"g":5737,"j":30,"p":584,"sj":false,"t":"Allah da onu tuttu, dünya ve ahiret azabıyla yakalayıverdi."},{"n":26,"g":5738,"j":30,"p":584,"sj":false,"t":"Kuşkusuz bunda, saygı duyacaklar için bir ibret vardır."},{"n":27,"g":5739,"j":30,"p":584,"sj":false,"t":"Yaratılışça siz mi daha çetinsiniz, yoksa gök mü? Onu Allah bina etti."},{"n":28,"g":5740,"j":30,"p":584,"sj":false,"t":"Tavanını yükseltti, onu bir düzene koydu."},{"n":29,"g":5741,"j":30,"p":584,"sj":false,"t":"Gecesini kararttı, kuşluğunu çıkardı."},{"n":30,"g":5742,"j":30,"p":584,"sj":false,"t":"Bundan sonra da yeryüzünü döşedi."},{"n":31,"g":5743,"j":30,"p":584,"sj":false,"t":"Ondan suyunu ve otlağını çıkardı."},{"n":32,"g":5744,"j":30,"p":584,"sj":false,"t":"Dağlarını oturttu."},{"n":33,"g":5745,"j":30,"p":584,"sj":false,"t":"Sizin ve hayvanlarınızın geçimi için."},{"n":34,"g":5746,"j":30,"p":584,"sj":false,"t":"Fakat o her şeyi bastıran büyük felaket geldiği vakit,"},{"n":35,"g":5747,"j":30,"p":584,"sj":false,"t":"O, insanın neyin peşinde koştuğunu anladığı gün,"},{"n":36,"g":5748,"j":30,"p":584,"sj":false,"t":"Gören kimseler için cehennem hortlatıldığı vakit,"},{"n":37,"g":5749,"j":30,"p":584,"sj":false,"t":"Artık her kim azgınlık etmiş,"},{"n":38,"g":5750,"j":30,"p":584,"sj":false,"t":"Ve dünya hayatını tercih etmişse,"},{"n":39,"g":5751,"j":30,"p":584,"sj":false,"t":"Kuşkusuz onun varacağı yer cehennemdir."},{"n":40,"g":5752,"j":30,"p":584,"sj":false,"t":"Kim de Rabbinin divanında durmaktan korkmuş, nefsini boş heveslerden menetmiş ise,"},{"n":41,"g":5753,"j":30,"p":584,"sj":false,"t":"Kuşkusuz onun varacağı yer cennettir."},{"n":42,"g":5754,"j":30,"p":584,"sj":false,"t":"Sana o kıyameti soruyorlar, ne zaman kopacak diye."},{"n":43,"g":5755,"j":30,"p":584,"sj":false,"t":"Sen nerde, onu anlatmak nerde?!"},{"n":44,"g":5756,"j":30,"p":584,"sj":false,"t":"Onun son ilmi Rabbine aittir."},{"n":45,"g":5757,"j":30,"p":584,"sj":false,"t":"Sen ancak ondan korkacak olanları uyarıcısın."},{"n":46,"g":5758,"j":30,"p":584,"sj":false,"t":"Onlar o kıyameti görecekleri gün sanki dünyada bir akşam veya kuşluğundan başka durmamışa dönecekler."}]}
