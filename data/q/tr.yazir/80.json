{"n":80,"a":[{"n":1,"g":5759,"j":30,"p":585,"sj":false,"t":"(Peygamber) Yüzünü ekşitti ve döndü."},{"n":2,"g":5760,"j":30,"p":585,"sj":false,"t":"Kendisine âmâ geldi, diye."},{"n":3,"g":5761,"j":30,"p":585,"sj":false,"t":"Ne bilirsin, belki o temizlenecek?"},{"n":4,"g":5762,"j":30,"p":585,"sj":false,"t":"Veya öğüt belleyecek de öğüt ona fayda verecek."},{"n":5,"g":5763,"j":30,"p":585,"sj":false,"t":"Ama buna ihtiyaç hissetmeyene gelince,"},{"n":6,"g":5764,"j":30,"p":585,"sj":false,"t":"Sen ona yöneliyorsun."},{"n":7,"g":5765,"j":30,"p":585,"sj":false,"t":"Onun temizlenmemesinden sana ne?"},{"n":8,"g":5766,"j":30,"p":585,"sj":false,"t":"Ama sana can atarak gelen,"},{"n":9,"g":5767,"j":30,"p":585,"sj":false,"t":"Allah'tan korkarak gelmişken,"},{"n":10,"g":5768,"j":30,"p":585,"sj":false,"t":"Sen onunla ilgilenmiyorsun."},{"n":11,"g":5769,"j":30,"p":585,"sj":false,"t":"Hayır hayır, sakın. Çünkü o Kur'ân bir öğüttür."},{"n":12,"g":5770,"j":30,"p":585,"sj":false,"t":"Artık dileyen onu düşünür."},{"n":13,"g":5771,"j":30,"p":585,"sj":false,"t":"O, değerli sahifelerdedir."},{"n":14,"g":5772,"j":30,"p":585,"sj":false,"t":"Yüksek tutulan tertemiz sahifelerde."},{"n":15,"g":5773,"j":30,"p":585,"sj":false,"t":"Yazıcıların ellerindedir,"},{"n":16,"g":5774,"j":30,"p":585,"sj":false,"t":"Değerli, iyi yazıcıların."},{"n":17,"g":5775,"j":30,"p":585,"sj":false,"t":"O kahrolası insan, ne nankör şey."},{"n":18,"g":5776,"j":30,"p":585,"sj":false,"t":"O yaratan onu hangi şeyden yarattı?"},{"n":19,"g":5777,"j":30,"p":585,"sj":false,"t":"Bir damla sudan, onu yarattı da biçime koydu."},{"n":20,"g":5778,"j":30,"p":585,"sj":false,"t":"Sonra ona yolunu kolaylaştırdı."},{"n":21,"g":5779,"j":30,"p":585,"sj":false,"t":"Sonra onu öldürdü de kabre koydurdu."},{"n":22,"g":5780,"j":30,"p":585,"sj":false,"t":"Sonra dilediği vakit onu tekrar diriltir."},{"n":23,"g":5781,"j":30,"p":585,"sj":false,"t":"Hayır hayır, doğrusu o, hiç Allah'ın emrini tam yerine getirmedi,"},{"n":24,"g":5782,"j":30,"p":585,"sj":false,"t":"Bir de o insan yiyeceğine baksın."},{"n":25,"g":5783,"j":30,"p":585,"sj":false,"t":"Biz o suyu bol bol döktük."},{"n":26,"g":5784,"j":30,"p":585,"sj":false,"t":"Sonra toprağı nasıl da yardık."},{"n":27,"g":5785,"j":30,"p":585,"sj":false,"t":"Bu suretle orada ekinler bitirdik."},{"n":28,"g":5786,"j":30,"p":585,"sj":false,"t":"Üzümler, yoncalar,"},{"n":29,"g":5787,"j":30,"p":585,"sj":false,"t":"Zeytinlikler, hurmalıklar,"},{"n":30,"g":5788,"j":30,"p":585,"sj":false,"t":"İri ve sık ağaçlı bahçeler,"},{"n":31,"g":5789,"j":30,"p":585,"sj":false,"t":"Meyveler, çayırlar bitirdik."},{"n":32,"g":5790,"j":30,"p":585,"sj":false,"t":"Siz ve hayvanlarınız faydalansın diye."},{"n":33,"g":5791,"j":30,"p":585,"sj":false,"t":"Kulakları sağır eden o gürültü geldiğinde,"},{"n":34,"g":5792,"j":30,"p":585,"sj":false,"t":"O gün kişi kaçar, kardeşinden..."},{"n":35,"g":5793,"j":30,"p":585,"sj":false,"t":"Anasından, babasından.."},{"n":36,"g":5794,"j":30,"p":585,"sj":false,"t":"Eşinden ve oğullarından."},{"n":37,"g":5795,"j":30,"p":585,"sj":false,"t":"Onlardan her birinin o gün başından aşan işi vardır."},{"n":38,"g":5796,"j":30,"p":585,"sj":false,"t":"Yüzler var ki, o gün parıl parıl,"},{"n":39,"g":5797,"j":30,"p":585,"sj":false,"t":"Güler, sevinir."},{"n":40,"g":5798,"j":30,"p":585,"sj":false,"t":"Yüzler de var ki, o gün tozlanmış,"},{"n":41,"g":5799,"j":30,"p":585,"sj":false,"t":"Onları karanlık bürümüş,"},{"n":42,"g":5800,"j":30,"p":585,"sj":false,"t":"İşte onlardır kâfirler, haktan sapanlar."}]}
