{"n":81,"a":[{"n":1,"g":5801,"j":30,"p":586,"sj":false,"t":"Güneş katlanıp dürüldüğünde,"},{"n":2,"g":5802,"j":30,"p":586,"sj":false,"t":"Yıldızlar bulandığında,"},{"n":3,"g":5803,"j":30,"p":586,"sj":false,"t":"Dağlar yürütüldüğünde,"},{"n":4,"g":5804,"j":30,"p":586,"sj":false,"t":"Kıyılmaz mallar bırakıldığında,"},{"n":5,"g":5805,"j":30,"p":586,"sj":false,"t":"Vahşi hayvanlar bir araya toplandığında,"},{"n":6,"g":5806,"j":30,"p":586,"sj":false,"t":"Denizler ateşlendiğinde (suları çekilip, volkanlar halinde ateş püskürdüğünde),"},{"n":7,"g":5807,"j":30,"p":586,"sj":false,"t":"Nefisler eşleştirildiğinde (iyiler iyilerle, kötüler kötülerle bir araya toplandığında),"},{"n":8,"g":5808,"j":30,"p":586,"sj":false,"t":"Diri diri toprağa gömülen kıza sorulduğunda,"},{"n":9,"g":5809,"j":30,"p":586,"sj":false,"t":"\"Hangi günahtan dolayı öldürüldü?\" diye."},{"n":10,"g":5810,"j":30,"p":586,"sj":false,"t":"Amel defterleri açıldığında,"},{"n":11,"g":5811,"j":30,"p":586,"sj":false,"t":"Gök sıyrılıp açıldığında,"},{"n":12,"g":5812,"j":30,"p":586,"sj":false,"t":"Cehennem kızıştırıldığında,"},{"n":13,"g":5813,"j":30,"p":586,"sj":false,"t":"Ve cennet yaklaştırıldığında,"},{"n":14,"g":5814,"j":30,"p":586,"sj":false,"t":"Herkes ne getirmiş olduğunu anlar."},{"n":15,"g":5815,"j":30,"p":586,"sj":false,"t":"Şimdi yemin ederim o sinenlere (gündüzleri gözden kaybolan yıldızlara),"},{"n":16,"g":5816,"j":30,"p":586,"sj":false,"t":"O akıp akıp yuvasına gidenlere,"},{"n":17,"g":5817,"j":30,"p":586,"sj":false,"t":"Yöneldiği an geceye,"},{"n":18,"g":5818,"j":30,"p":586,"sj":false,"t":"Nefeslendiği (ağardığı) an sabaha ki,"},{"n":19,"g":5819,"j":30,"p":586,"sj":false,"t":"Kuşkusuz o Kur'an, değerli bir elçinin sözüdür."},{"n":20,"g":5820,"j":30,"p":586,"sj":false,"t":"O elçi güçlüdür, Arş'ın sahibinin yanında çok itibarlıdır."},{"n":21,"g":5821,"j":30,"p":586,"sj":false,"t":"Orada ona itaat edilir, güvenilir."},{"n":22,"g":5822,"j":30,"p":586,"sj":false,"t":"Arkadaşınızı cin çarpmış değildir."},{"n":23,"g":5823,"j":30,"p":586,"sj":false,"t":"Andolsun o, Cebrail'i açık ufukta gördü."},{"n":24,"g":5824,"j":30,"p":586,"sj":false,"t":"O, gayb hakkında cimri de değildir."},{"n":25,"g":5825,"j":30,"p":586,"sj":false,"t":"O, kovulmuş bir şeytanın sözü değildir."},{"n":26,"g":5826,"j":30,"p":586,"sj":false,"t":"Hâl böyle iken, siz nereye gidiyorsunuz?"},{"n":27,"g":5827,"j":30,"p":586,"sj":false,"t":"O, âlemler için öğütten başka bir şey değildir,"},{"n":28,"g":5828,"j":30,"p":586,"sj":false,"t":"İçinizden doğru gitmek isteyenler için."},{"n":29,"g":5829,"j":30,"p":586,"sj":false,"t":"Âlemlerin Rabbi olan Allah dilemeyince, siz dileyemezsiniz."}]}
