{"n":82,"a":[{"n":1,"g":5830,"j":30,"p":587,"sj":false,"t":"Gök çatladığı vakit,"},{"n":2,"g":5831,"j":30,"p":587,"sj":false,"t":"Yıldızlar döküldüğü vakit,"},{"n":3,"g":5832,"j":30,"p":587,"sj":false,"t":"Denizler yarılıp akıtıldığı vakit,"},{"n":4,"g":5833,"j":30,"p":587,"sj":false,"t":"Kabirlerin içi dışına getirildiği vakit,"},{"n":5,"g":5834,"j":30,"p":587,"sj":false,"t":"Herkes neyi önünden gönderdiğini ve neyi geri bıraktığını bilir."},{"n":6,"g":5835,"j":30,"p":587,"sj":false,"t":"Ey insan! İhsanı bol Rabb'ine karşı seni aldatan nedir?"},{"n":7,"g":5836,"j":30,"p":587,"sj":false,"t":"O Allah ki seni yarattı, seni düzgün yapılı kılıp ölçülü bir biçim verdi."},{"n":8,"g":5837,"j":30,"p":587,"sj":false,"t":"Seni dilediği her hangi bir şekilde parçalardan oluşturdu."},{"n":9,"g":5838,"j":30,"p":587,"sj":false,"t":"Hayır hayır, siz cezayı yalanlıyorsunuz."},{"n":10,"g":5839,"j":30,"p":587,"sj":false,"t":"Oysa üzerinizde koruyucular var."},{"n":11,"g":5840,"j":30,"p":587,"sj":false,"t":"Değerli yazıcılar"},{"n":12,"g":5841,"j":30,"p":587,"sj":false,"t":"Onlar, siz her ne yaparsanız bilirler"},{"n":13,"g":5842,"j":30,"p":587,"sj":false,"t":"Kuşkusuz iyiler nimet içindedirler."},{"n":14,"g":5843,"j":30,"p":587,"sj":false,"t":"Kötüler de cehennemdedirler."},{"n":15,"g":5844,"j":30,"p":587,"sj":false,"t":"Ceza günü ona girecekler."},{"n":16,"g":5845,"j":30,"p":587,"sj":false,"t":"Onlar o cehennemin gözünden kaçamazlar."},{"n":17,"g":5846,"j":30,"p":587,"sj":false,"t":"Ceza gününün ne olduğunu sen bilir misin?"},{"n":18,"g":5847,"j":30,"p":587,"sj":false,"t":"Evet, bilir misin nedir acaba o ceza günü?"},{"n":19,"g":5848,"j":30,"p":587,"sj":false,"t":"O gün, hiç kimsenin başkası için hiçbir şeye sahip olamadığı gündür. O gün buyruk yalnız Allah'ındır."}]}
