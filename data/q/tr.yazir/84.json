{"n":84,"a":[{"n":1,"g":5885,"j":30,"p":589,"sj":false,"t":"Gök yarıldığı,"},{"n":2,"g":5886,"j":30,"p":589,"sj":false,"t":"Rabbini dinleyip kendisine yaraşır şekilde boyun eğdiği vakit,"},{"n":3,"g":5887,"j":30,"p":589,"sj":false,"t":"Yer uzatılıp düzlendiği,"},{"n":4,"g":5888,"j":30,"p":589,"sj":false,"t":"İçinde ne varsa attığı ve tamamen boşaldığı"},{"n":5,"g":5889,"j":30,"p":589,"sj":false,"t":"Ve Rabbini dinleyip kendisine yaraşır şekilde boyun eğdiği vakit,"},{"n":6,"g":5890,"j":30,"p":589,"sj":false,"t":"Ey insan! Kuşkusuz sen Rabbine doğru çaba üstüne çaba sarfetmektesin, nihayet O'na varacaksın."},{"n":7,"g":5891,"j":30,"p":589,"sj":false,"t":"O vakit kitabı sağ eline verilen,"},{"n":8,"g":5892,"j":30,"p":589,"sj":false,"t":"Kolay bir hesapla hesaba çekilecek,"},{"n":9,"g":5893,"j":30,"p":589,"sj":false,"t":"Ve sevinçli olarak ailesine dönecektir."},{"n":10,"g":5894,"j":30,"p":589,"sj":false,"t":"Ama kitabı arkasından verilen,"},{"n":11,"g":5895,"j":30,"p":589,"sj":false,"t":"\"Yetiş ey ölüm!\" diye bağıracak"},{"n":12,"g":5896,"j":30,"p":589,"sj":false,"t":"Ve alevli ateşe girecektir."},{"n":13,"g":5897,"j":30,"p":589,"sj":false,"t":"Çünkü o ailesi içinde sevinçli idi."},{"n":14,"g":5898,"j":30,"p":589,"sj":false,"t":"Hiç Rabbine dönmeyeceğini sanmıştı."},{"n":15,"g":5899,"j":30,"p":589,"sj":false,"t":"Hayır Rabbi onu görmekte idi."},{"n":16,"g":5900,"j":30,"p":589,"sj":false,"t":"Şimdi, yemin ederim o şafağa,"},{"n":17,"g":5901,"j":30,"p":589,"sj":false,"t":"Geceye ve içinde barındırdığı şeylere,"},{"n":18,"g":5902,"j":30,"p":589,"sj":false,"t":"Derlendiği zaman o aya,"},{"n":19,"g":5903,"j":30,"p":589,"sj":false,"t":"Ki, siz elbette halden hale geçeceksiniz."},{"n":20,"g":5904,"j":30,"p":589,"sj":false,"t":"Böyleyken onlar neden acaba iman etmezler?"},{"n":21,"g":5905,"j":30,"p":589,"sj":true,"t":"Karşılarında Kur'ân okunduğu vakit secde etmezler?"},{"n":22,"g":5906,"j":30,"p":589,"sj":false,"t":"Aksine o nankörler yalanlıyorlar."},{"n":23,"g":5907,"j":30,"p":589,"sj":false,"t":"Oysa Allah içlerinde sakladıklarını biliyor."},{"n":24,"g":5908,"j":30,"p":589,"sj":false,"t":"Onun için onlara elem verici bir azabı müjdele."},{"n":25,"g":5909,"j":30,"p":589,"sj":false,"t":"Ancak iman edip iyi ameller işleyenler başkadır. Onlara tükenmez bir ecir vardır."}]}
