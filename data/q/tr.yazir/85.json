{"n":85,"a":[{"n":1,"g":5910,"j":30,"p":590,"sj":false,"t":"Burçlar sahibi gökyüzüne,"},{"n":2,"g":5911,"j":30,"p":590,"sj":false,"t":"Vaad olunan o güne,"},{"n":3,"g":5912,"j":30,"p":590,"sj":false,"t":"Şahitlik edene ve edilene andolsun ki,"},{"n":4,"g":5913,"j":30,"p":590,"sj":false,"t":"Kahroldu o hendeğin sahipleri,"},{"n":5,"g":5914,"j":30,"p":590,"sj":false,"t":"O çıralı ateşin,"},{"n":6,"g":5915,"j":30,"p":590,"sj":false,"t":"Hani o ateşin başına oturmuşlar,"},{"n":7,"g":5916,"j":30,"p":590,"sj":false,"t":"Müminlere yaptıklarını seyrediyorlardı."},{"n":8,"g":5917,"j":30,"p":590,"sj":false,"t":"Müminlere kızmalarının sebebi de, onların yalnız çok güçlü ve övgüye lâyık olan Allah'a iman etmeleri idi."},{"n":9,"g":5918,"j":30,"p":590,"sj":false,"t":"O Allah ki, göklerin ve yerin hükümranlığı O'nundur ve Allah her şeye şahittir."},{"n":10,"g":5919,"j":30,"p":590,"sj":false,"t":"İnanan erkek ve kadınlara işkence yapıp sonra da tevbe etmeyenlere cehennem azabı ve yangın azabı vardır."},{"n":11,"g":5920,"j":30,"p":590,"sj":false,"t":"İnanan ve iyi amel yapanlar için de altından ırmaklar akan cennetler vardır. İşte büyük kurtuluş odur."},{"n":12,"g":5921,"j":30,"p":590,"sj":false,"t":"Kuşkusuz Rabbinin yakalaması serttir."},{"n":13,"g":5922,"j":30,"p":590,"sj":false,"t":"Yoktan o yaratır ve tekrar o diriltir."},{"n":14,"g":5923,"j":30,"p":590,"sj":false,"t":"Bununla beraber çok bağışlayandır, çok sevendir."},{"n":15,"g":5924,"j":30,"p":590,"sj":false,"t":"Arş'ın sahibidir, yücedir."},{"n":16,"g":5925,"j":30,"p":590,"sj":false,"t":"Dilediğini yapandır."},{"n":17,"g":5926,"j":30,"p":590,"sj":false,"t":"O orduların kıssası sana geldi mi?"},{"n":18,"g":5927,"j":30,"p":590,"sj":false,"t":"Yani Firavun ve Semud'un?"},{"n":19,"g":5928,"j":30,"p":590,"sj":false,"t":"Fakat o inkarcılar hâlâ bir yalanlama içinde."},{"n":20,"g":5929,"j":30,"p":590,"sj":false,"t":"Oysa Allah onları arkalarından kuşatmıştır."},{"n":21,"g":5930,"j":30,"p":590,"sj":false,"t":"Hayır o şerefli bir Kur'ân'dır."},{"n":22,"g":5931,"j":30,"p":590,"sj":false,"t":"Levhi Mahfuz'dadır."}]}
