{"n":86,"a":[{"n":1,"g":5932,"j":30,"p":591,"sj":false,"t":"Andolsun o göğe ve Târık'a,"},{"n":2,"g":5933,"j":30,"p":591,"sj":false,"t":"Târık nedir, bildin mi?"},{"n":3,"g":5934,"j":30,"p":591,"sj":false,"t":"O, karanlığı delen yıldızdır."},{"n":4,"g":5935,"j":30,"p":591,"sj":false,"t":"Hiçbir nefis yoktur ki başında bir denetleyici bulunmasın."},{"n":5,"g":5936,"j":30,"p":591,"sj":false,"t":"Onun için insan neden yaratıldığına bir baksın."},{"n":6,"g":5937,"j":30,"p":591,"sj":false,"t":"Atılan bir sudan yaratıldı."},{"n":7,"g":5938,"j":30,"p":591,"sj":false,"t":"O su, erkeğin sulbü ile kadının göğüs kemikleri arasından çıkar."},{"n":8,"g":5939,"j":30,"p":591,"sj":false,"t":"Elbette Allah'ın onu döndürmeye gücü yeter."},{"n":9,"g":5940,"j":30,"p":591,"sj":false,"t":"O gün bütün sırlar yoklanıp, meydana çıkarılır."},{"n":10,"g":5941,"j":30,"p":591,"sj":false,"t":"İnsanın o gün ne bir gücü vardır, ne de bir yardımcısı."},{"n":11,"g":5942,"j":30,"p":591,"sj":false,"t":"Andolsun o dönüşlü göğe,"},{"n":12,"g":5943,"j":30,"p":591,"sj":false,"t":"O yarılıp çatlayan yere,"},{"n":13,"g":5944,"j":30,"p":591,"sj":false,"t":"Kuşkusuz Kur'ân, ayırıcı bir sözdür."},{"n":14,"g":5945,"j":30,"p":591,"sj":false,"t":"O asla bir şaka değildir."},{"n":15,"g":5946,"j":30,"p":591,"sj":false,"t":"Haberin olsun ki, kâfirler hep hile kuruyorlar."},{"n":16,"g":5947,"j":30,"p":591,"sj":false,"t":"Ben de hilelerine karşılık veririm."},{"n":17,"g":5948,"j":30,"p":591,"sj":false,"t":"Onun için sen kâfirlere mühlet ver, onlara az bir zaman tanı."}]}
