{"n":88,"a":[{"n":1,"g":5968,"j":30,"p":592,"sj":false,"t":"O her şeyi kuşatacak olan Kıyamet'in haberi sana geldi mi?"},{"n":2,"g":5969,"j":30,"p":592,"sj":false,"t":"Yüzler var ki, o gün eğilmiş, zillete düşmüştür."},{"n":3,"g":5970,"j":30,"p":592,"sj":false,"t":"Çalışmış, yorulmuştur."},{"n":4,"g":5971,"j":30,"p":592,"sj":false,"t":"Kızışmış bir ateşe girer."},{"n":5,"g":5972,"j":30,"p":592,"sj":false,"t":"Onlara kızgın bir kaynaktan su verilir."},{"n":6,"g":5973,"j":30,"p":592,"sj":false,"t":"Onlar için kuru bir dikenden başka yiyecek de yoktur."},{"n":7,"g":5974,"j":30,"p":592,"sj":false,"t":"O da ne besler, ne de açlığı giderir."},{"n":8,"g":5975,"j":30,"p":592,"sj":false,"t":"Yüzler de var ki, o gün nimetle mutludur."},{"n":9,"g":5976,"j":30,"p":592,"sj":false,"t":"Yaptığından hoşnuttur."},{"n":10,"g":5977,"j":30,"p":592,"sj":false,"t":"Yüksek bir cennettedir."},{"n":11,"g":5978,"j":30,"p":592,"sj":false,"t":"Orada boş bir söz işitmez."},{"n":12,"g":5979,"j":30,"p":592,"sj":false,"t":"Orada akan bir kaynak,"},{"n":13,"g":5980,"j":30,"p":592,"sj":false,"t":"Yükseltilmiş divanlar,"},{"n":14,"g":5981,"j":30,"p":592,"sj":false,"t":"Konulmuş kadehler,"},{"n":15,"g":5982,"j":30,"p":592,"sj":false,"t":"Dizilmiş koltuklar, yastıklar,"},{"n":16,"g":5983,"j":30,"p":592,"sj":false,"t":"Serilmiş halılar vardır."},{"n":17,"g":5984,"j":30,"p":592,"sj":false,"t":"Bakmıyorlar mı o develere, nasıl yaratılmış?"},{"n":18,"g":5985,"j":30,"p":592,"sj":false,"t":"Göğe bakmıyorlar mı, nasıl yükseltilmiş?"},{"n":19,"g":5986,"j":30,"p":592,"sj":false,"t":"Bakmıyorlar mı dağlara, nasıl dikilmiş?"},{"n":20,"g":5987,"j":30,"p":592,"sj":false,"t":"Yere bakmıyorlar mı, nasıl yayılmış?"},{"n":21,"g":5988,"j":30,"p":592,"sj":false,"t":"Haydi öğüt ver; sen şimdi sırf bir öğütçüsün."},{"n":22,"g":5989,"j":30,"p":592,"sj":false,"t":"Onların üzerinde bir zorba değilsin."},{"n":23,"g":5990,"j":30,"p":592,"sj":false,"t":"Ancak kim yüz çevirir ve kâfir olursa,"},{"n":24,"g":5991,"j":30,"p":592,"sj":false,"t":"Allah ona en büyük azap ile azap edecek."},{"n":25,"g":5992,"j":30,"p":592,"sj":false,"t":"Kuşkusuz onlar döne dolaşa bize gelecekler."},{"n":26,"g":5993,"j":30,"p":592,"sj":false,"t":"Sonra da bize hesap verecekler."}]}
