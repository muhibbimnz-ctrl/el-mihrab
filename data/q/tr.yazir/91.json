{"n":91,"a":[{"n":1,"g":6044,"j":30,"p":595,"sj":false,"t":"Güneş'e ve onun parıltısına,"},{"n":2,"g":6045,"j":30,"p":595,"sj":false,"t":"Güneş'in ardından gelen Ay'a,"},{"n":3,"g":6046,"j":30,"p":595,"sj":false,"t":"Güneş'i açıp ortaya çıkaran gündüze,"},{"n":4,"g":6047,"j":30,"p":595,"sj":false,"t":"Onu örten geceye,"},{"n":5,"g":6048,"j":30,"p":595,"sj":false,"t":"Göğe ve onu bina edene,"},{"n":6,"g":6049,"j":30,"p":595,"sj":false,"t":"Yere ve onu döşeyene,"},{"n":7,"g":6050,"j":30,"p":595,"sj":false,"t":"Nefse ve onu biçimlendirene,"},{"n":8,"g":6051,"j":30,"p":595,"sj":false,"t":"Sonra da ona kötülük ve takva kabiliyetini verene yemin olsun ki,"},{"n":9,"g":6052,"j":30,"p":595,"sj":false,"t":"Elbette nefsini temizleyip parlatan kurtulmuştur."},{"n":10,"g":6053,"j":30,"p":595,"sj":false,"t":"Onu kirletip gömen de ziyan etmiştir."},{"n":11,"g":6054,"j":30,"p":595,"sj":false,"t":"Semud, azgınlığıyla Hakk'ı yalanladı,"},{"n":12,"g":6055,"j":30,"p":595,"sj":false,"t":"En azgınları ileri atılınca,"},{"n":13,"g":6056,"j":30,"p":595,"sj":false,"t":"Allah'ın Rasulü (Salih peygamber) onlara: \"Allah'ın devesini ve onun su nöbetini gözetin.\" demişti."},{"n":14,"g":6057,"j":30,"p":595,"sj":false,"t":"Fakat onlar peygamberi yalanlayıp deveyi kestiler. Rableri de günahlarını başlarına geçiriverdi de orayı dümdüz etti."},{"n":15,"g":6058,"j":30,"p":595,"sj":false,"t":"Öyle ya, Allah bu işin sonundan korkacak değil ya."}]}
