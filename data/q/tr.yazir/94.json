{"n":94,"a":[{"n":1,"g":6091,"j":30,"p":596,"sj":false,"t":"Biz senin için (mutluluğun) göğsünü açmadık mı?"},{"n":2,"g":6092,"j":30,"p":596,"sj":false,"t":"Senden yükünü indirmedik mi?"},{"n":3,"g":6093,"j":30,"p":596,"sj":false,"t":"O senin sırtını ezen yükü."},{"n":4,"g":6094,"j":30,"p":596,"sj":false,"t":"Senin şanını yüceltmedik mi?"},{"n":5,"g":6095,"j":30,"p":596,"sj":false,"t":"Demek ki, zorlukla beraber bir kolaylık vardır."},{"n":6,"g":6096,"j":30,"p":596,"sj":false,"t":"Evet, zorlukla beraber bir kolaylık vardır."},{"n":7,"g":6097,"j":30,"p":596,"sj":false,"t":"O halde boş kaldın mı, yine kalk (başka bir iş ve ibadetle) yorul."},{"n":8,"g":6098,"j":30,"p":596,"sj":false,"t":"Ancak Rabbine yönel."}]}
