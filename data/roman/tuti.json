{"id":"tuti","dil":"fa","seviye":"A2","baslik":"طوطی و بازرگان","tr_baslik":"Tûtî ve Tüccar (Mesnevî)","yazar":"Mevlânâ Celâleddîn-i Rûmî — uyarlama","not":"Mesnevî’deki hikâyenin el-Mihrâb için A2 seviyesinde yeniden anlatımıdır; özgün manzum metin değildir.","bolumler":[{"b":"بازرگان و طوطی","tr_b":"Tüccar ve papağan","c":[["در شهری بزرگ بازرگانی ثروتمند زندگی می‌کرد.","Büyük bir şehirde zengin bir tüccar yaşıyordu."],["خانه‌اش بزرگ بود و باغی پر از گل داشت.","Evi büyüktü ve çiçeklerle dolu bir bahçesi vardı."],["در این خانه طوطی سبز و زیبایی در قفسی طلایی زندگی می‌کرد.","Bu evde yeşil ve güzel bir papağan altın bir kafeste yaşıyordu."],["طوطی خیلی باهوش بود و مثل آدم حرف می‌زد.","Papağan çok akıllıydı ve insan gibi konuşurdu."],["بازرگان طوطی را خیلی دوست داشت.","Tüccar papağanı çok severdi."],["هر روز به او شکر و دانه می‌داد و با او حرف می‌زد.","Her gün ona şeker ve tane verir, onunla konuşurdu."],["مهمان‌ها از صدای خوش طوطی تعجب می‌کردند.","Misafirler papağanın güzel sesine şaşarlardı."],["اما طوطی همیشه از پشت میله‌های قفس به آسمان نگاه می‌کرد.","Ama papağan her zaman kafesin parmaklıklarının arkasından gökyüzüne bakardı."]]},{"b":"سفر به هندوستان","tr_b":"Hindistan yolculuğu","c":[["یک روز بازرگان تصمیم گرفت برای تجارت به هندوستان برود.","Bir gün tüccar ticaret için Hindistan’a gitmeye karar verdi."],["همه‌ی خانواده و خدمتکاران را جمع کرد.","Bütün aileyi ve hizmetçileri topladı."],["گفت: «من به هند می‌روم. از آنجا چه هدیه‌ای برای شما بیاورم؟»","Dedi ki: “Hindistan’a gidiyorum. Oradan size ne hediye getireyim?”"],["زنش گفت: «برای من پارچه‌ی ابریشمی بیاور.»","Karısı dedi ki: “Bana ipek kumaş getir.”"],["پسرش گفت: «برای من یک شمشیر زیبا بیاور.»","Oğlu dedi ki: “Bana güzel bir kılıç getir.”"],["دخترش گفت: «من دستبند طلا می‌خواهم.»","Kızı dedi ki: “Ben altın bilezik istiyorum.”"],["خدمتکاران هم هر کدام چیزی خواستند.","Hizmetçiler de her biri bir şey istedi."],["بازرگان همه را در دفترش نوشت.","Tüccar hepsini defterine yazdı."]]},{"b":"پیام طوطی","tr_b":"Papağanın mesajı","c":[["آخر سر بازرگان پیش قفس رفت و پرسید: «تو چه می‌خواهی، طوطی عزیزم؟»","En sonunda tüccar kafesin yanına gitti ve sordu: “Sen ne istersin, sevgili papağanım?”"],["طوطی کمی ساکت ماند و بعد گفت: «من هدیه نمی‌خواهم.»","Papağan biraz sessiz kaldı ve sonra dedi ki: “Ben hediye istemiyorum.”"],["«فقط یک پیام از من به طوطی‌های هند برسان.»","“Sadece benden Hindistan’ın papağanlarına bir mesaj ulaştır.”"],["«وقتی در هند طوطی‌ها را در درختان دیدی، سلام مرا به آنها بگو.»","“Hindistan’da papağanları ağaçlarda gördüğünde onlara selamımı söyle.”"],["«بگو: دوست شما در قفس است و دلش برای شما تنگ شده.»","“De ki: Dostunuz kafeste ve sizi özledi.”"],["«آیا رواست که شما در باغ آزاد باشید و من در زندان بمیرم؟»","“Sizin bahçede özgür olmanız, benim ise zindanda ölmem reva mı?”"],["«از آنها بپرس: راه نجات من چیست؟»","“Onlara sor: Benim kurtuluş yolum nedir?”"],["بازرگان خندید و گفت: «باشد، پیامت را می‌رسانم.»","Tüccar güldü ve dedi ki: “Peki, mesajını ulaştırırım.”"]]},{"b":"راه دراز","tr_b":"Uzun yol","c":[["بازرگان با کاروانی بزرگ راه افتاد.","Tüccar büyük bir kervanla yola çıktı."],["شترها بار سنگینی از پارچه و ادویه داشتند.","Develerin kumaş ve baharattan ağır bir yükü vardı."],["آنها از کوه‌ها و بیابان‌های زیادی گذشتند.","Birçok dağı ve çölü geçtiler."],["شب‌ها زیر ستاره‌ها می‌خوابیدند.","Geceleri yıldızların altında uyuyorlardı."],["بعضی روزها باد شدید می‌آمد و خاک همه جا را می‌پوشاند.","Bazı günler şiddetli rüzgâr esiyor ve toz her yeri kaplıyordu."],["بعد از دو ماه به رودخانه‌ای بزرگ رسیدند.","İki ay sonra büyük bir ırmağa vardılar."],["با کشتی از رودخانه گذشتند و به هندوستان رسیدند.","Gemiyle ırmağı geçtiler ve Hindistan’a vardılar."],["هوا گرم بود و همه جا سبز و پر از درخت بود.","Hava sıcaktı ve her yer yeşil ve ağaçlarla doluydu."]]},{"b":"بازار هند","tr_b":"Hindistan çarşısı","c":[["بازرگان به بازار بزرگ شهر رفت.","Tüccar şehrin büyük çarşısına gitti."],["بازار پر از رنگ و بو و صدا بود.","Çarşı renk, koku ve sesle doluydu."],["فروشندگان فلفل و دارچین و چای و سنگ‌های قیمتی می‌فروختند.","Satıcılar biber, tarçın, çay ve değerli taşlar satıyordu."],["بازرگان کالاهایش را فروخت و سود زیادی برد.","Tüccar mallarını sattı ve çok kâr etti."],["بعد هدیه‌ها را یکی یکی خرید.","Sonra hediyeleri birer birer satın aldı."],["پارچه‌ی ابریشمی برای زنش، شمشیر برای پسرش، دستبند برای دخترش.","Karısı için ipek kumaş, oğlu için kılıç, kızı için bilezik."],["خوشحال بود و به خانه فکر می‌کرد.","Mutluydu ve evi düşünüyordu."],["ناگهان پیام طوطی یادش آمد.","Birden papağanın mesajı aklına geldi."]]},{"b":"طوطی‌های جنگل","tr_b":"Ormanın papağanları","c":[["بازرگان از شهر بیرون رفت و به جنگلی رسید.","Tüccar şehirden çıktı ve bir ormana vardı."],["روی شاخه‌های درختان صدها طوطی سبز نشسته بودند.","Ağaçların dallarında yüzlerce yeşil papağan oturuyordu."],["آنها آزادانه از این درخت به آن درخت پرواز می‌کردند.","Özgürce bu ağaçtan o ağaca uçuyorlardı."],["بازرگان ایستاد و با صدای بلند گفت: «ای طوطی‌ها، سلام!»","Tüccar durdu ve yüksek sesle dedi ki: “Ey papağanlar, selam!”"],["«طوطی من در قفس است و به شما سلام می‌رساند.»","“Benim papağanım kafeste ve size selam gönderiyor.”"],["«می‌گوید: دلم برای شما تنگ است؛ راه نجات من چیست؟»","“Diyor ki: Sizi özledim; benim kurtuluş yolum nedir?”"],["هنوز حرفش تمام نشده بود که اتفاق عجیبی افتاد.","Daha sözü bitmemişti ki tuhaf bir şey oldu."]]},{"b":"طوطی افتاد","tr_b":"Papağan düştü","c":[["یکی از طوطی‌ها شروع کرد به لرزیدن.","Papağanlardan biri titremeye başladı."],["بعد از شاخه افتاد و روی زمین بی‌حرکت ماند.","Sonra daldan düştü ve yerde hareketsiz kaldı."],["بازرگان ترسید و پشیمان شد.","Tüccar korktu ve pişman oldu."],["با خودش گفت: «وای! من این طوطی را کشتم!»","Kendi kendine dedi ki: “Eyvah! Bu papağanı ben öldürdüm!”"],["«شاید این طوطی از خویشان طوطی من بود.»","“Belki bu papağan benim papağanımın akrabalarındandı.”"],["«چرا این پیام را رساندم؟ زبان من آتش است.»","“Bu mesajı neden ulaştırdım? Dilim ateştir.”"],["«حرفی که از دهان بیرون آمد، دیگر برنمی‌گردد.»","“Ağızdan çıkan söz bir daha geri dönmez.”"],["غمگین به شهر برگشت و چند روز با کسی حرف نزد.","Üzgün bir şekilde şehre döndü ve birkaç gün kimseyle konuşmadı."]]},{"b":"بازگشت","tr_b":"Dönüş","c":[["سرانجام کار بازرگان در هند تمام شد.","Sonunda tüccarın Hindistan’daki işi bitti."],["او با کاروان به سوی خانه برگشت.","Kervanla eve doğru döndü."],["در راه همیشه به طوطی جنگل فکر می‌کرد.","Yolda hep ormandaki papağanı düşünüyordu."],["وقتی به شهر خود رسید، همه به استقبالش آمدند.","Kendi şehrine vardığında herkes onu karşılamaya geldi."],["هدیه‌ها را به خانواده داد و همه خوشحال شدند.","Hediyeleri ailesine verdi ve herkes sevindi."],["پسرش شمشیر را بالا گرفت و دخترش دستبند را به دست کرد.","Oğlu kılıcı havaya kaldırdı, kızı da bileziği koluna taktı."],["اما بازرگان پیش قفس نرفت؛ از طوطی خجالت می‌کشید.","Ama tüccar kafesin yanına gitmedi; papağandan utanıyordu."]]},{"b":"سؤال طوطی","tr_b":"Papağanın sorusu","c":[["شب، طوطی او را صدا زد: «ای صاحب من، چرا پیش من نمی‌آیی؟»","Gece papağan onu çağırdı: “Ey sahibim, neden yanıma gelmiyorsun?”"],["«پیام مرا رساندی؟ طوطی‌های هند چه گفتند؟»","“Mesajımı ulaştırdın mı? Hindistan’ın papağanları ne dedi?”"],["بازرگان آهی کشید و گفت: «کاش آن پیام را نمی‌رساندم.»","Tüccar iç çekti ve dedi ki: “Keşke o mesajı ulaştırmasaydım.”"],["«وقتی پیامت را گفتم، یکی از آنها لرزید و از درخت افتاد و مرد.»","“Mesajını söylediğimde içlerinden biri titredi, ağaçtan düştü ve öldü.”"],["«من از گفتن آن پیام پشیمانم.»","“O mesajı söylediğime pişmanım.”"],["طوطی این را شنید و هیچ نگفت.","Papağan bunu duydu ve hiçbir şey demedi."],["ناگهان او هم لرزید و در قفس افتاد و بی‌حرکت ماند.","Birden o da titredi, kafesin içine düştü ve hareketsiz kaldı."]]},{"b":"غم بازرگان","tr_b":"Tüccarın kederi","c":[["بازرگان فریاد زد و کلاهش را بر زمین زد.","Tüccar bağırdı ve şapkasını yere çarptı."],["«ای طوطی شیرین زبان من! ای همدم من!»","“Ey tatlı dilli papağanım! Ey dert ortağım!”"],["«چه کردم؟ با یک خبر دو طوطی را کشتم!»","“Ne yaptım? Bir haberle iki papağanı öldürdüm!”"],["همه‌ی خانواده جمع شدند و گریه کردند.","Bütün aile toplandı ve ağladı."],["بازرگان در قفس را باز کرد.","Tüccar kafesin kapısını açtı."],["طوطی را آرام بیرون آورد و روی زمین گذاشت.","Papağanı yavaşça dışarı çıkardı ve yere koydu."],["گفت: «حالا دیگر قفس برای چه؟ بگذار آزاد باشد.»","Dedi ki: “Artık kafes ne işe yarar? Bırak özgür olsun.”"]]},{"b":"پرواز","tr_b":"Uçuş","c":[["در همان لحظه طوطی بال زد و پرید.","Tam o anda papağan kanat çırptı ve havalandı."],["روی بلندترین شاخه‌ی درخت باغ نشست.","Bahçedeki ağacın en yüksek dalına kondu."],["بازرگان حیران ماند و گفت: «تو زنده‌ای؟»","Tüccar şaşkın kaldı ve dedi ki: “Sen yaşıyor musun?”"],["طوطی گفت: «آن طوطی هند نمرده بود.»","Papağan dedi ki: “Hindistan’daki o papağan ölmemişti.”"],["«او با کارش به من درسی داد.»","“Yaptığıyla bana bir ders verdi.”"],["«گفت: تو را صدای خوشت در قفس نگه داشته است.»","“Dedi ki: Seni kafeste tutan güzel sesindir.”"],["«اگر آزادی می‌خواهی، بمیر پیش از آنکه بمیری.»","“Özgürlük istiyorsan, ölmeden önce öl.”"]]},{"b":"درس طوطی","tr_b":"Papağanın dersi","c":[["بازرگان گفت: «این حرف یعنی چه؟»","Tüccar dedi ki: “Bu söz ne demek?”"],["طوطی گفت: «یعنی از خودخواهی و هوس بگذر.»","Papağan dedi ki: “Yani bencillikten ve hevesten vazgeç.”"],["«تا وقتی که به خودت و به تعریف مردم دلبسته‌ای، در قفسی.»","“Kendine ve insanların övgüsüne bağlı olduğun sürece kafestesin.”"],["«قفس من از طلا بود، اما باز هم قفس بود.»","“Benim kafesim altındandı ama yine de kafesti.”"],["«حالا خداحافظ، ای صاحب مهربان من.»","“Şimdi hoşça kal, ey iyi kalpli sahibim.”"],["«تو هم روزی از قفس خودت آزاد شو.»","“Sen de bir gün kendi kafesinden kurtul.”"],["بعد پرواز کرد و در آسمان آبی ناپدید شد.","Sonra uçtu ve mavi gökyüzünde gözden kayboldu."]]},{"b":"سخن مولانا","tr_b":"Mevlânâ’nın sözü","c":[["بازرگان مدتی زیر درخت نشست و فکر کرد.","Tüccar bir süre ağacın altında oturdu ve düşündü."],["فهمید که خودش هم در قفسی از مال و نام زندگی می‌کند.","Kendisinin de maldan ve şöhretten bir kafeste yaşadığını anladı."],["از آن روز به فقیران بیشتر کمک کرد.","O günden sonra fakirlere daha çok yardım etti."],["و کمتر به حرف مردم اهمیت داد.","Ve insanların sözüne daha az önem verdi."],["مولانا این داستان را در مثنوی آورده است.","Mevlânâ bu hikâyeyi Mesnevî’de anlatmıştır."],["در نظر او طوطی جان انسان است و قفس، دنیا.","Onun gözünde papağan insanın ruhudur, kafes de dünya."],["و هند، جای دوستانی است که جان از آنجا آمده است.","Hindistan da ruhun oradan geldiği dostların yeridir."]]}],"sozluk":{"روزی":"bir gün","رستم":"Rüstem","پهلوان":"kahraman, pehlivan","بزرگ":"büyük","ایران":"İran","برای":"için","شکار":"av","به":"-e","مرز":"sınır","توران":"Turan","رفت":"gitti","پس":"sonra","از":"-den","کنار":"kenar","رودخانه":"nehir","خوابید":"uyudu","و":"ve","اسبش":"atı","رخش":"Rahş (Rüstem’in atı)","در":"-de; kapı","دشت":"ova","می‌چرید":"otluyordu","چند":"birkaç","سوار":"süvari, atlı","تورانی":"Turanlı","را":"(belirtme eki)","دیدند":"gördüler","او":"o","با":"ile","خود":"kendi","بردند":"götürdüler","وقتی":"-dığında","بیدار":"uyanık","شد":"oldu","ندید":"görmedi","بسیار":"çok","خشمگین":"öfkeli","رد":"iz","پای":"ayak","گرفت":"aldı, tuttu","شهر":"şehir","سمنگان":"Semengân","رسید":"vardı","شاه":"şah","گرمی":"sıcaklık (“به گرمی” sıcak bir şekilde)","پذیرایی":"ağırlama","کرد":"etti","قول":"söz","داد":"verdi","پیدا":"bulunmuş (“پیدا کردن” bulmak)","کند":"etsin","آن":"o","شب":"gece","دختر":"kız","تهمینه":"Tehmîne","نزد":"yanına","آمد":"geldi","گفت":"dedi","که":"ki","داستان":"hikâye","دلاوری‌های":"kahramanlıkları","شنیده":"duymuş","دلش":"gönlünü","داده":"vermiş","است":"-dir","اجازهٔ":"izni","ازدواج":"evlilik","هنگام":"sırasında","رفتن":"gitmek","مهره‌ای":"bir mühre (muska taşı)","اگر":"eğer","فرزندی":"bir çocuk","داشتی":"olursa (senin)","این":"bu","بازویش":"onun kolu","ببند":"bağla","نه":"dokuz; hayır","ماه":"ay","پسری":"bir oğul","دنیا":"dünya","نامش":"adı","سهراب":"Sührâb","گذاشتند":"koydular","خیلی":"çok","زود":"çabuk","ده‌سالگی":"on yaşında","هیچ‌کس":"hiç kimse","حریفش":"onun dengi","نبود":"değildi, yoktu","مادرش":"annesi","پرسید":"sordu","پدرم":"babam","کیست":"kimdir","تو":"sen","پسر":"oğul","هستی":"-sin