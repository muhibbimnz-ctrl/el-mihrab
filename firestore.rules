rules_version = '2';
// el-Mihrâb: her kullanıcı yalnız kendi belgesini okuyup yazabilir.
// Üyelik: ödeme yapan Gmail adresleri "uyeler/{eposta}" belgesinde durur: bitis (Timestamp) ve paketler (["mbsts"|"yds"|"max"]).
// Anahtarlar: kadem/anahtar → Max · kadem/anahtar-mbsts → Pro MBSTS ya da Max · kadem/anahtar-yds → Pro YDS ya da Max.
// Her biri yalnız süresi dolmamış ve o paketi almış üyeye açılır. Üyeleri ve anahtarları yalnız "yoneticiler/{eposta}" yazar.
service cloud.firestore {
  match /databases/{database}/documents {
    function eposta() { return request.auth.token.email.lower() }
    function girisli() { return request.auth != null && request.auth.token.email_verified == true }
    function yonetici() { return girisli() && exists(/databases/$(database)/documents/yoneticiler/$(eposta())) }
    function uye() {
      return girisli() && exists(/databases/$(database)/documents/uyeler/$(eposta()))
        && get(/databases/$(database)/documents/uyeler/$(eposta())).data.bitis > request.time
    }
    // paketler alanı olmayan eski kayıtlar Max sayılır
    function paket(p) {
      let d = get(/databases/$(database)/documents/uyeler/$(eposta())).data;
      return uye() && (!('paketler' in d) || d.paketler.hasAny([p, 'max']));
    }

    match /kullanicilar/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.veri is string
                            && request.resource.data.veri.size() < 1000000;
    }
    match /uyeler/{e} {
      allow read: if (girisli() && eposta() == e) || yonetici();
      allow write: if yonetici();
    }
    match /kadem/anahtar {
      allow read: if yonetici() || paket('max');
      allow write: if yonetici();
    }
    match /kadem/anahtar-mbsts {
      allow read: if yonetici() || paket('mbsts');
      allow write: if yonetici();
    }
    match /kadem/anahtar-yds {
      allow read: if yonetici() || paket('yds');
      allow write: if yonetici();
    }
    match /yoneticiler/{e} {
      allow read: if girisli() && eposta() == e;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
